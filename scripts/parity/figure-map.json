    { "after": "{month}/templateGroups/CreditCard/members/*/totalOwed", "before": "{month}/cards/*/accumulatedOutstandingTotal", "negate": false, "reason": "F14 Credit cards grid member" },
    { "after": "{month}/templateGroups/Pots/totals/GBP", "before": "{month}/pots/total", "negate": false, "reason": "F14 Pots grid total" }
  ]
