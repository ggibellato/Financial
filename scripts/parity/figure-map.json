    { "after": "{month}/summary/cardMembers/*/outstandingTotal", "before": "{month}/cards/*/outstandingTotal", "negate": false, "reason": "F07 summary card member" },
    { "after": "{month}/summary/cardMembers/*/isPaid", "before": "{month}/cards/*/isPaid", "negate": false, "reason": "F07 summary card member" },
    { "after": "{month}/summary/cardMembers/*/balance", "before": "{month}/cards/*/accumulatedOutstandingTotal", "negate": true, "reason": "F07 summary card member, current month only" },
    { "after": "{month}/summary/totals/GBP/cardOutstandingTotal", "before": "{month}/monthly/cardOutstandingTotal", "negate": false, "reason": "F07 summary card total" },
    { "after": "{month}/otherAccounts/potsTotal", "before": "{month}/pots/total", "negate": false, "reason": "F09 Pots account total" },
