<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.BalanceAdjustmentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" Margin="0,0,0,12" Background="#FAFAFA">
        <Grid>
            <!-- Post-save result -->
            <StackPanel Visibility="{Binding HasAdjustmentResult, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontWeight="Bold" Text="Balance Corrected" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding AdjustmentSavedDelta, StringFormat='Adjustment of {0:N2} recorded'}"/>
                <Button Content="Close" Width="90" HorizontalAlignment="Left" Margin="0,12,0,0"
                        Command="{Binding DismissAdjustmentResultCommand}"/>
            </StackPanel>

            <!-- Form -->
            <Grid Visibility="{Binding ShowAdjustmentForm, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Correct Balance"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingAdjustment}" Value="True">
                                    <Setter Property="Text" Value="Edit Balance Adjustment"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Current calculated balance for {0}: {1:N2}">
                            <Binding Path="AdjustmentFormBankName"/>
                            <Binding Path="AdjustmentFormCurrentBalance"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Date:" VerticalAlignment="Center"/>
                <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding AdjustmentFormDate, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Target Balance:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AdjustmentFormTargetBalance, UpdateSourceTrigger=LostFocus}"
                         PreviewTextInput="OnDecimalTextBoxPreviewTextInput"
                         DataObject.Pasting="OnDecimalTextBoxPasting"
                         LostFocus="OnDecimalTextBoxLostFocus"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Note:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AdjustmentFormNote, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap"
                           Text="{Binding AdjustmentSaveError}" Margin="0,8,0,0"/>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Width="110" Command="{Binding SaveAdjustmentCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Correct Balance"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingAdjustment}" Value="True">
                                        <Setter Property="Content" Value="Save"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSavingAdjustment}" Value="True">
                                        <Setter Property="Content" Value="Saving..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Cancel" Width="90" Margin="8,0,0,0" Command="{Binding CancelAdjustmentFormCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
