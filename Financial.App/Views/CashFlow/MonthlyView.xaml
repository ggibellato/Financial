<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.MonthlyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Financial.Presentation.App.Components"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.CashFlow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <components:MonthYearPicker SelectedYear="{Binding Year, Mode=TwoWay}"
                                         SelectedMonth="{Binding Month, Mode=TwoWay}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Loading..." FontSize="14"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
            <Button Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibilityConverter}}">
            <TabItem Header="Summary">
                <local:MonthlySummaryView/>
            </TabItem>
            <TabItem Header="Bank expenses">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <local:BanksGridView Grid.Row="0"/>
                    <local:ExpenseSectionView Grid.Row="1" DataContext="{Binding Expense}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Credit Card expenses">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <local:CardsGridView Grid.Row="0" ShowCardManagementColumns="True" DataContext="{Binding Cards}"/>
                    <local:CreditCardExpensesView Grid.Row="1" DataContext="{Binding Expense}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Income">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <local:IncomeTotalsGridView Grid.Row="0"/>
                    <local:IncomeSectionView Grid.Row="1" DataContext="{Binding Income}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Bank balance adjustment">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <local:BanksGridView Grid.Row="0"/>
                    <local:BankSectionView Grid.Row="1" DataContext="{Binding BankOperations}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
