<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.EditReserveMovementFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.CashFlow">
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" Margin="0,0,0,12" Background="#FAFAFA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Text="Edit Movement" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bucket:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:ReservaViewModel.Buckets}"
                      SelectedItem="{Binding EditBucket, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Amount:" VerticalAlignment="Center"/>
            <!-- Plain TextBox (not the shared decimal-masked input): unlike other CashFlow amount
                 fields, this one must accept a leading minus sign for withdrawal movements. -->
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditAmount, UpdateSourceTrigger=LostFocus}"
                     LostFocus="OnAmountTextBoxLostFocus"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Date:" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding EditDate, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Description:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap"
                       Text="{Binding EditSaveError}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Width="90" Command="{Binding SaveMovementEditCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Save"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSavingMovement}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Cancel" Width="90" Margin="8,0,0,0" Command="{Binding CancelEditFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
