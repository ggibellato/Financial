<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.IncomeTotalsGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding IncomeTotals}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Source}" Header="Source" Width="*"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Header="Gross" Width="110"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}">
                    <DataGridTextColumn.Binding>
                        <Binding Path="GrossValue" StringFormat="N2" TargetNullValue="—"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding NetValue, StringFormat=N2}" Header="Net" Width="110"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Total Incoming: "/>
            <TextBlock Text="{Binding TotalIncoming, StringFormat=N2}" FontWeight="Bold"/>
            <TextBlock Text=" · Calculated Tithe: "/>
            <TextBlock Text="{Binding TitheSummary.CalculatedTithe, StringFormat=N2}" FontWeight="Bold"/>
            <TextBlock Text=" · Tithe Balance: "/>
            <TextBlock Text="{Binding TitheSummary.TitheBalance, StringFormat=N2}" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                        Visibility="{Binding HasTitheCarryForward, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text=" · Carry forward: "/>
                <CheckBox IsChecked="{Binding TitheSummary.CarryForward.Included, Mode=OneWay}"
                          IsEnabled="{Binding IsCarryForwardToggleEnabled}"
                          AutomationProperties.Name="{Binding CarryForwardAccessibleName}"
                          Checked="OnCarryForwardIncludedChanged" Unchecked="OnCarryForwardIncludedChanged"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TitheSummary.CarryForward.Amount, StringFormat=N2}" FontWeight="Bold"/>
                <TextBlock Text=" from "/>
                <TextBlock Text="{Binding TitheSummary.CarryForward.FromMonth}" FontWeight="Bold"/>
                <TextBlock Text="/"/>
                <TextBlock Text="{Binding TitheSummary.CarryForward.FromYear}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="{Binding TitheCarryForwardUpdateError}"/>
    </Grid>
</UserControl>
