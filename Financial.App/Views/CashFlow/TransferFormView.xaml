<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.TransferFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        Four equal-width columns, label-above-control per field — matches
        ExpenseFormView's layout standard (docs/ui/forms-data-and-visualisations
        .md's "Layout" rule) instead of the old single-column label-left row
        stack.
    -->
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" FontWeight="Bold" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Move Money"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingTransfer}" Value="True">
                                <Setter Property="Text" Value="Edit Transfer"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Date"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <DatePicker AutomationProperties.Name="Transfer date"
                            AutomationProperties.HelpText="Required"
                            SelectedDate="{Binding TransferFormDate, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding DateFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="From"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <ComboBox AutomationProperties.Name="From"
                          AutomationProperties.HelpText="Required"
                          ItemsSource="{Binding Banks}" DisplayMemberPath="Name"
                          SelectedValue="{Binding TransferFormSourceBank, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Id"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding SourceBankFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="To"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <ComboBox AutomationProperties.Name="To"
                          AutomationProperties.HelpText="Required"
                          ItemsSource="{Binding Banks}" DisplayMemberPath="Name"
                          SelectedValue="{Binding TransferFormDestinationBank, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Id"/>
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                           Text="{Binding SameBankTransferError}"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding DestinationBankFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Amount"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <TextBox AutomationProperties.Name="Amount"
                         AutomationProperties.HelpText="Required"
                         Text="{Binding TransferFormAmount, UpdateSourceTrigger=LostFocus}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding AmountFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,8">
                <TextBlock Text="Note" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Note"
                         Text="{Binding TransferFormNote, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding TransferSaveError}"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal">
                <ui:Button MinWidth="110" Appearance="Primary" Command="{Binding SaveTransferCommand}">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Move Money"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingTransfer}" Value="True">
                                    <Setter Property="Content" Value="Save"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSavingTransfer}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" Appearance="Secondary"
                           Command="{Binding CancelTransferFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
