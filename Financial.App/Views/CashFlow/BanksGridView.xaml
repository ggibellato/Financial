<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.BanksGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.CashFlow">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding BankHistoryError}"/>

        <local:TransferFormView Grid.Row="1"
                                 Visibility="{Binding IsTransferFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding BankTotals}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Expand/collapse history" Padding="4,0"
                                    Command="{Binding DataContext.ToggleBankExpandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="▸"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Content" Value="▾"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Bank}" Header="Bank" Width="140"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding Balance, StringFormat=N2}" Header="Bank Balance" Width="120"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding RoundUpTotal, StringFormat=N2}" Header="Round-Up" Width="100"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Move Money" Padding="4,0"
                                    Command="{Binding DataContext.ShowMoveMoneyFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding Bank}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowDetailsVisibilityMode>Collapsed</DataGrid.RowDetailsVisibilityMode>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="DetailsVisibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Grid Margin="34,4,0,8">
                        <TextBlock Text="No transfers or adjustments this month." FontStyle="Italic" Visibility="Collapsed">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding History.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✏" ToolTip="Edit transfer" Padding="4,0" Visibility="Collapsed"
                                                    Command="{Binding DataContext.EditTransferCommand, RelativeSource={RelativeSource AncestorType=DataGrid, AncestorLevel=2}}"
                                                    CommandParameter="{Binding Transfer}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="TransferOut">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="TransferIn">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑" ToolTip="Delete" Padding="4,0"
                                                    Command="{Binding DataContext.DeleteHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid, AncestorLevel=2}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding Date, StringFormat=d}" Header="Date" Width="100"
                                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                                <DataGridTextColumn Binding="{Binding Kind}" Header="Type" Width="120"
                                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                                <DataGridTextColumn Binding="{Binding CounterpartBank}" Header="Counterpart" Width="140"
                                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                                <DataGridTextColumn Binding="{Binding Amount, StringFormat=N2}" Header="Amount" Width="100"
                                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                                <DataGridTextColumn Binding="{Binding Delta, StringFormat=N2}" Header="Delta" Width="100"
                                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                                <DataGridTextColumn Binding="{Binding Note}" Header="Note" Width="*"
                                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,8,0,0">
            <TextBlock.Text>
                <MultiBinding StringFormat="Bank Balance: {0:N2} · Round-Up: {1:N2}">
                    <Binding Path="BankTotalsSum"/>
                    <Binding Path="RoundUpTotalsSum"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </Grid>
</UserControl>
