<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.MonthlySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.CashFlow">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" ItemsSource="{Binding CategoryTotals}" MaxHeight="320">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Category}" Header="Category" Width="*"
                                         ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                    <DataGridTextColumn Binding="{Binding TotalValue, StringFormat=N2}" Header="Total" Width="140"
                                         ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1" Margin="0,8,0,0" FontWeight="Bold"
                       Text="{Binding CategoryTotalsSum, StringFormat='Total: {0:N2}'}"/>
        </Grid>

        <local:CardsGridView Grid.Row="0" Grid.Column="1" Margin="12,0,0,0"/>

        <local:BanksGridView Grid.Row="1" Grid.Column="0" Margin="0,12,12,0"/>
        <local:IncomeTotalsGridView Grid.Row="1" Grid.Column="1" Margin="12,12,0,0"/>
    </Grid>
</UserControl>
