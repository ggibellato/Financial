<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.ReservaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.CashFlow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Loading..." FontSize="14"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>
            <Button Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="0" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="New Income Split" Command="{Binding ShowSplitFormCommand}"/>
                <Button Content="New Withdrawal" Margin="8,0,0,0" Command="{Binding ShowWithdrawalFormCommand}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,16">
                <local:IncomeSplitFormView Visibility="{Binding IsSplitFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <local:WithdrawalFormView Visibility="{Binding IsWithdrawalFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <local:EditReserveMovementFormView Visibility="{Binding IsEditFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <DataGrid ItemsSource="{Binding Balances}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Bucket}" Header="Bucket" Width="180"
                                             ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                        <DataGridTextColumn Binding="{Binding Balance, StringFormat=N2}" Header="Balance" Width="140"
                                             ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Margin="0,8,0,0" FontWeight="Bold" Text="{Binding TotalBalance, StringFormat='Total: {0:N2}'}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding DeleteMovementError}"/>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✏" ToolTip="Edit" Padding="4,0"
                                        Command="{Binding DataContext.EditMovementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" ToolTip="Delete" Padding="4,0"
                                        Command="{Binding DataContext.DeleteMovementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Date, StringFormat=d}" Header="Date" Width="100"
                                         ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                    <DataGridTextColumn Binding="{Binding Bucket}" Header="Bucket" Width="140"
                                         ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                    <DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*"
                                         ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                    <DataGridTextColumn Binding="{Binding Amount, StringFormat=N2}" Header="Amount" Width="110"
                                         ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsVisibilityMode>Collapsed</DataGrid.RowDetailsVisibilityMode>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasGroupTotal}" Value="True">
                                <Setter Property="DetailsVisibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <TextBlock Margin="8,2,0,4" FontStyle="Italic">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Total split for &quot;{0}&quot;: {1:N2}">
                                    <Binding Path="Description"/>
                                    <Binding Path="GroupTotal"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
