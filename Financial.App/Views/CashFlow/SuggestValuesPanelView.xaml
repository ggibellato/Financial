<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.SuggestValuesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
            <!-- Muted/struck-through current value for a checked row that would overwrite an
                 existing non-zero value - makes the overwrite explicit, matching Financial.Web's
                 equivalent styling for the same row state. -->
            <Style x:Key="MutedOverwriteValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NumericColumnTextStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOverwriteCandidate}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <StackPanel>
            <TextBlock FontWeight="Bold" Text="Suggest Values" Margin="0,0,0,8"/>

            <TextBlock Text="Loading suggestions..."
                       Visibility="{Binding IsSuggestionsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <StackPanel Visibility="{Binding HasSuggestionsError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding SuggestionsError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
                <ui:Button Content="Retry" Appearance="Primary" Command="{Binding RetrySuggestionsFetchCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowSuggestionsContent, Converter={StaticResource BoolToVisibilityConverter}}">

                <TextBlock Text="No suggestions available for this month."
                           Visibility="{Binding ShowEmptySuggestionsMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="0,0,0,8"/>

                <DataGrid ItemsSource="{Binding SuggestionRows}" AutoGenerateColumns="False"
                          IsReadOnly="{Binding IsApplyingSuggestions}" CanUserAddRows="False"
                          Visibility="{Binding HasSuggestionRows, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding AccountName}" Header="Account" Width="*" IsReadOnly="True"
                                             ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                        <DataGridTextColumn Binding="{Binding CurrentValue, StringFormat=N2}" Header="Current Value" Width="110" IsReadOnly="True"
                                             ElementStyle="{StaticResource MutedOverwriteValueTextStyle}"/>
                        <DataGridTextColumn Binding="{Binding SuggestedValue}" Header="Suggested Value" Width="110"
                                             ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                        <DataGridTextColumn Binding="{Binding SourceDescription}" Header="Source" Width="2*" IsReadOnly="True"
                                             ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                        <DataGridTemplateColumn Header="Include" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.CanEditSuggestions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              AutomationProperties.Name="{Binding AccountName, StringFormat='Include {0}'}"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Visibility="{Binding HasNotUpdatedSuggestions, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,8">
                    <TextBlock FontWeight="SemiBold" Text="Not updated" Margin="0,0,0,4"/>
                    <DataGrid ItemsSource="{Binding NotUpdatedSuggestionRows}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding AccountName}" Header="Account" Width="*"
                                                 ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                            <DataGridTextColumn Binding="{Binding Reason}" Header="Reason" Width="2*"
                                                 ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <StackPanel Visibility="{Binding IsApplyingSuggestions, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,8">
                    <!-- No explicit Foreground: the default Wpf.Ui ProgressBar template is already
                         theme/accent-aware, matching AssetPriceView.xaml's ProgressBar. -->
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding ApplyProgressPercent, Mode=OneWay}"/>
                    <TextBlock Text="{Binding ApplyProgressText}" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding CompletionSummaryText}" TextWrapping="Wrap"
                           Visibility="{Binding HasCompletedApply, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{Binding CheckedSuggestionsCount, StringFormat='Apply {0} Suggestions'}"
                               Appearance="Primary" Command="{Binding ApplySuggestionsCommand}" Margin="0,0,8,0">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsApplyingSuggestions}" Value="False"/>
                                            <Condition Binding="{Binding HasCompletedApply}" Value="False"/>
                                            <Condition Binding="{Binding HasSuggestionRows}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="Retry Failed" Appearance="Primary" Command="{Binding RetryFailedSuggestionsCommand}" Margin="0,0,8,0"
                               Visibility="{Binding HasFailedSuggestions, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ui:Button Appearance="Secondary" Command="{Binding CancelSuggestValuesCommand}" IsEnabled="{Binding CanEditSuggestions}">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Content" Value="Cancel"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCompletedApply}" Value="True">
                                        <Setter Property="Content" Value="Close"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
