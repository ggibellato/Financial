<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.CreditCardsGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding CreditCardUpdateError}"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding CreditCards}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Header="Card" Width="180"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTemplateColumn Header="Next Invoice Due Date" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding NextInvoiceDueDate, Converter={StaticResource DateOnlyToDateTimeConverter}, Mode=OneWay}"
                                        SelectedDateChanged="OnDueDateChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Active" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsActive, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      Checked="OnActiveChanged" Unchecked="OnActiveChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
