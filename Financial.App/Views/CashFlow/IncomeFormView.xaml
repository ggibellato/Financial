<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.IncomeFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        Four equal-width columns, label-above-control per field — matches
        ExpenseFormView's layout standard (docs/ui/forms-data-and-visualisations
        .md's "Layout" rule) instead of the old single-column label-left row
        stack.
    -->
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" FontWeight="Bold" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="New Income"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingIncome}" Value="True">
                                <Setter Property="Text" Value="Edit Income"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Row 1: Date | Source | Gross Value (conditional) | Net Value -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}"/>
                <DatePicker AutomationProperties.Name="Income date"
                            SelectedDate="{Binding IncomeFormDate, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                <TextBlock Text="Source" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox AutomationProperties.Name="Source"
                          ItemsSource="{Binding IncomeSourceOptions}" DisplayMemberPath="Name"
                          SelectedValue="{Binding IncomeFormSource, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Id"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,8"
                        Visibility="{Binding ShowIncomeGrossValueField, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Gross Value" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Gross value"
                         Text="{Binding IncomeFormGrossValue, UpdateSourceTrigger=LostFocus}"
                         PreviewTextInput="OnDecimalTextBoxPreviewTextInput"
                         DataObject.Pasting="OnDecimalTextBoxPasting"
                         LostFocus="OnDecimalTextBoxLostFocus"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                <TextBlock Text="Net Value" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Net value"
                         Text="{Binding IncomeFormNetValue, UpdateSourceTrigger=LostFocus}"
                         PreviewTextInput="OnDecimalTextBoxPreviewTextInput"
                         DataObject.Pasting="OnDecimalTextBoxPasting"
                         LostFocus="OnDecimalTextBoxLostFocus"/>
            </StackPanel>

            <!-- Row 2: Bank | Description (spans 3) -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Bank" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox AutomationProperties.Name="Bank"
                          ItemsSource="{Binding IncomeBankOptions}" DisplayMemberPath="Name"
                          SelectedValue="{Binding IncomeFormBank, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Id"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,8,8">
                <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Description"
                         Text="{Binding IncomeFormDescription, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <CheckBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,8" VerticalAlignment="Bottom"
                      Content="Split to reserve" AutomationProperties.Name="Split to reserve"
                      Visibility="{Binding ShowIncomeSplitField, Converter={StaticResource BoolToVisibilityConverter}}"
                      IsChecked="{Binding IncomeFormSplitToReserve, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding IncomeSaveError}"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal">
                <ui:Button MinWidth="110" Appearance="Primary" Command="{Binding SaveIncomeCommand}">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Add Income"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingIncome}" Value="True">
                                    <Setter Property="Content" Value="Save"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSavingIncome}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" Appearance="Secondary"
                           Command="{Binding CancelIncomeFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
