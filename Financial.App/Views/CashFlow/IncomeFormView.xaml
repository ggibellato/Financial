<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.IncomeFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" Margin="0,0,0,12" Background="#FAFAFA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="New Income"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingIncome}" Value="True">
                                <Setter Property="Text" Value="Edit Income"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date:" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding IncomeFormDate, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Source:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding IncomeSourceOptions}"
                      SelectedItem="{Binding IncomeFormSource, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Gross Value:" VerticalAlignment="Center"
                       Visibility="{Binding ShowIncomeGrossValueField, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IncomeFormGrossValue, UpdateSourceTrigger=LostFocus}"
                     Visibility="{Binding ShowIncomeGrossValueField, Converter={StaticResource BoolToVisibilityConverter}}"
                     PreviewTextInput="OnDecimalTextBoxPreviewTextInput"
                     DataObject.Pasting="OnDecimalTextBoxPasting"
                     LostFocus="OnDecimalTextBoxLostFocus"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Net Value:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding IncomeFormNetValue, UpdateSourceTrigger=LostFocus}"
                     PreviewTextInput="OnDecimalTextBoxPreviewTextInput"
                     DataObject.Pasting="OnDecimalTextBoxPasting"
                     LostFocus="OnDecimalTextBoxLostFocus"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Bank:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Banks}" DisplayMemberPath="Name"
                      SelectedValue="{Binding IncomeFormBank, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Name"/>

            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap"
                       Text="{Binding IncomeSaveError}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Width="90" Command="{Binding SaveIncomeCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Add Income"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingIncome}" Value="True">
                                    <Setter Property="Content" Value="Save"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSavingIncome}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Cancel" Width="90" Margin="8,0,0,0" Command="{Binding CancelIncomeFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
