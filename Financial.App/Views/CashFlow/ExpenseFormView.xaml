<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.ExpenseFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Financial.Presentation.App.Components">
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" Margin="0,0,0,12" Background="#FAFAFA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="New Expense"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingExpense}" Value="True">
                                <Setter Property="Text" Value="Edit Expense"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date:" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding ExpenseFormDate, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExpenseFormDescription, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Category:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding ExpenseFormCategory, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Value:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ExpenseFormValue, UpdateSourceTrigger=LostFocus}"
                     PreviewTextInput="OnSignedDecimalTextBoxPreviewTextInput"
                     DataObject.Pasting="OnSignedDecimalTextBoxPasting"
                     LostFocus="OnDecimalTextBoxLostFocus"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Invoice Month:" VerticalAlignment="Center"
                       Visibility="{Binding IsCardPaymentMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <components:MonthYearTextBox Grid.Row="5" Grid.Column="1"
                                          Visibility="{Binding IsCardPaymentMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                          IsEnabled="{Binding ShowPaymentModeFields}"
                                          HorizontalAlignment="Left"
                                          SelectedYear="{Binding ExpenseFormInvoiceYear, Mode=TwoWay}"
                                          SelectedMonth="{Binding ExpenseFormInvoiceMonth, Mode=TwoWay}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Payment:" VerticalAlignment="Top"
                       Visibility="{Binding ExpenseFormIsSettled, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap"
                       Visibility="{Binding ExpenseFormIsSettled, Converter={StaticResource BoolToVisibilityConverter}}">
                <Run Text="Paid via "/>
                <Run Text="{Binding ExpenseFormCreditCardName, Mode=OneWay}"/>
                <Run Text=". Settled via its card statement — unmark the statement paid to change this expense."/>
            </TextBlock>

            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                        Visibility="{Binding ShowPaymentModeFields, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="0,8,0,0" Visibility="{Binding IsCardPaymentMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Card:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ActiveCreditCards}" DisplayMemberPath="Name"
                              SelectedValue="{Binding ExpenseFormCreditCardId, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Id"/>
                </Grid>

                <StackPanel Visibility="{Binding IsBankPaymentMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Payment Source:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Banks}" DisplayMemberPath="Name"
                                  SelectedValue="{Binding ExpenseFormPaymentSource, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Id"/>
                    </Grid>
                    <Grid Margin="0,8,0,0" Visibility="{Binding ShowRoundUpField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Round-Up:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ExpenseFormRoundUpAmount, UpdateSourceTrigger=LostFocus}"
                                 PreviewTextInput="OnDecimalTextBoxPreviewTextInput"
                                 DataObject.Pasting="OnDecimalTextBoxPasting"
                                 LostFocus="OnDecimalTextBoxLostFocus"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap"
                       Text="{Binding ExpenseSaveError}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Width="90" Command="{Binding SaveExpenseCommand}"
                        Visibility="{Binding ShowPaymentModeFields, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Add Expense"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingExpense}" Value="True">
                                    <Setter Property="Content" Value="Save"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSavingExpense}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Cancel" Width="90" Margin="8,0,0,0" Command="{Binding CancelExpenseFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
