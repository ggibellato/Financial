<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.ExpenseFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:Financial.Presentation.App.Components">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="New Expense"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingExpense}" Value="True">
                                <Setter Property="Text" Value="Edit Expense"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date:" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Expense date"
                        SelectedDate="{Binding ExpenseFormDate, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Category:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Category"
                      ItemsSource="{Binding ActiveCategories}" DisplayMemberPath="Name"
                      SelectedValue="{Binding ExpenseFormCategoryId, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Id"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Description"
                     Text="{Binding ExpenseFormDescription, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Value:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" AutomationProperties.Name="Value"
                     Text="{Binding ExpenseFormValue, UpdateSourceTrigger=LostFocus}"
                     PreviewTextInput="OnSignedDecimalTextBoxPreviewTextInput"
                     DataObject.Pasting="OnSignedDecimalTextBoxPasting"
                     LostFocus="OnDecimalTextBoxLostFocus"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Counts toward tithe:" VerticalAlignment="Center"
                       Visibility="{Binding ShowCountsAsTitheField, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <CheckBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Counts toward tithe"
                      Visibility="{Binding ShowCountsAsTitheField, Converter={StaticResource BoolToVisibilityConverter}}"
                      IsChecked="{Binding ExpenseFormCountsAsTithe, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Invoice Month:" VerticalAlignment="Center"
                       Visibility="{Binding IsCardPaymentMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <components:MonthYearTextBox Grid.Row="6" Grid.Column="1" AutomationProperties.Name="Invoice month"
                                          Visibility="{Binding IsCardPaymentMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                          IsEnabled="{Binding ShowPaymentModeFields}"
                                          HorizontalAlignment="Left"
                                          SelectedYear="{Binding ExpenseFormInvoiceYear, Mode=TwoWay}"
                                          SelectedMonth="{Binding ExpenseFormInvoiceMonth, Mode=TwoWay}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Payment:" VerticalAlignment="Top"
                       Visibility="{Binding ExpenseFormIsSettled, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap"
                       Visibility="{Binding ExpenseFormIsSettled, Converter={StaticResource BoolToVisibilityConverter}}">
                <Run Text="Paid via "/>
                <Run Text="{Binding ExpenseFormCreditCardName, Mode=OneWay}"/>
                <Run Text=". Settled via its card statement — unmark the statement paid to change this expense."/>
            </TextBlock>

            <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                        Visibility="{Binding ShowPaymentModeFields, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="0,8,0,0" Visibility="{Binding IsCardPaymentMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Card:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" AutomationProperties.Name="Card"
                              ItemsSource="{Binding ActiveCreditCards}" DisplayMemberPath="Name"
                              SelectedValue="{Binding ExpenseFormCreditCardId, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Id"/>
                </Grid>

                <StackPanel Visibility="{Binding IsBankPaymentMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Payment Source:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" AutomationProperties.Name="Payment source"
                                  ItemsSource="{Binding Banks}" DisplayMemberPath="Name"
                                  SelectedValue="{Binding ExpenseFormPaymentSource, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Id"/>
                    </Grid>
                    <Grid Margin="0,8,0,0" Visibility="{Binding ShowRoundUpField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Round-Up:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" AutomationProperties.Name="Round-up amount"
                                 Text="{Binding ExpenseFormRoundUpAmount, UpdateSourceTrigger=LostFocus}"
                                 PreviewTextInput="OnDecimalTextBoxPreviewTextInput"
                                 DataObject.Pasting="OnDecimalTextBoxPasting"
                                 LostFocus="OnDecimalTextBoxLostFocus"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding ExpenseSaveError}"/>

            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Width="90" Appearance="Primary" Command="{Binding SaveExpenseCommand}"
                           Visibility="{Binding ShowPaymentModeFields, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Add Expense"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingExpense}" Value="True">
                                    <Setter Property="Content" Value="Save"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSavingExpense}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Cancel" Width="90" Margin="8,0,0,0" Appearance="Secondary"
                           Command="{Binding CancelExpenseFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
