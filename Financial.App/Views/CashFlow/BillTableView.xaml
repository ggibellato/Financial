<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.BillTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Financial.Presentation.App.Controls"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.CashFlow"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="root">
    <DataGrid ItemsSource="{Binding Bills, ElementName=root}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding DueDay}" Header="Due Day" Width="70"
                                 ElementStyle="{StaticResource NumericColumnTextStyle}"/>
            <DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*"
                                 ElementStyle="{StaticResource PlainColumnTextStyle}"/>
            <DataGridTextColumn Binding="{Binding Note}" Header="Note" Width="140"
                                 ElementStyle="{StaticResource PlainColumnTextStyle}"/>
            <DataGridTextColumn Binding="{Binding NitNumber}" Header="NIT" Width="100"
                                 ElementStyle="{StaticResource PlainColumnTextStyle}"
                                 Visibility="{Binding ShowBrasilFields, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <DataGridTextColumn Binding="{Binding MinimumWageValue, StringFormat=N2}" Header="Min. Wage" Width="100"
                                 ElementStyle="{StaticResource NumericColumnTextStyle}"
                                 Visibility="{Binding ShowBrasilFields, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <DataGridTextColumn Binding="{Binding Value, StringFormat=N2}" Header="Value" Width="100"
                                 ElementStyle="{StaticResource NumericColumnTextStyle}"/>
            <DataGridTemplateColumn Header="Status" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:StatusSplitButton Statuses="{x:Static vm:MensaisViewModel.Statuses}"
                                                     Status="{Binding Status}"
                                                     Bill="{Binding}"
                                                     ChangeStatusCommand="{Binding ChangeStatusCommand, ElementName=root}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="34">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ui:Button Appearance="Transparent" Padding="4,0"
                                   Icon="{ui:SymbolIcon Symbol=Edit16}"
                                   ToolTip="Edit" AutomationProperties.Name="Edit"
                                   Command="{Binding EditBillCommand, ElementName=root}"
                                   CommandParameter="{Binding}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="34">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ui:Button Appearance="Transparent" Padding="4,0"
                                   Icon="{ui:SymbolIcon Symbol=Delete16}"
                                   ToolTip="Delete" AutomationProperties.Name="Delete"
                                   Command="{Binding DeleteBillCommand, ElementName=root}"
                                   CommandParameter="{Binding}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
