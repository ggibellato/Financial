<Window x:Class="Financial.Presentation.App.Views.CashFlow.UkExpensePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Generate expense for this payment?"
        Height="420"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Date" Margin="0,0,0,4"/>
        <DatePicker Grid.Row="1"
                    AutomationProperties.Name="Date"
                    SelectedDate="{Binding Date}"
                    Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Description" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3"
                 AutomationProperties.Name="Description"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"/>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Value" Margin="0,0,0,4"/>
                <TextBox AutomationProperties.Name="Value" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Bank" Margin="0,0,0,4"/>
                <ComboBox AutomationProperties.Name="Bank"
                          ItemsSource="{Binding Banks}" DisplayMemberPath="Name"
                          SelectedValue="{Binding BankId, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Id"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Category" Margin="0,0,0,4"/>
            <ComboBox AutomationProperties.Name="Category"
                      ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                      SelectedValue="{Binding CategoryId, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Id"/>
        </StackPanel>

        <TextBlock Grid.Row="6"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button Content="Confirm" Appearance="Primary" MinWidth="80" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            <ui:Button Content="Skip" Appearance="Secondary" MinWidth="70" Margin="8,0,0,0" Command="{Binding SkipCommand}"/>
            <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="70" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
