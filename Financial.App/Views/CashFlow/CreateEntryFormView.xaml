<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.CreateEntryFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.CashFlow">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" FontWeight="Bold" Text="New Entry" Margin="0,0,0,8"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Date"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <DatePicker AutomationProperties.Name="Date"
                            AutomationProperties.HelpText="Required"
                            SelectedDate="{Binding CreateDate, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding CreateDateFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Currency"/>
                <ComboBox AutomationProperties.Name="Currency"
                          ItemsSource="{x:Static vm:ControleMaeViewModel.Currencies}"
                          SelectedItem="{Binding CreateCurrency, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Description"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <TextBox AutomationProperties.Name="Description"
                         AutomationProperties.HelpText="Required"
                         Text="{Binding CreateDescription, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding CreateDescriptionFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Note"/>
                <TextBox AutomationProperties.Name="Note"
                         Text="{Binding CreateNote, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Value"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <!-- Plain TextBox (not the shared decimal-masked input): the source value may be
                     negative (a debit), so it must accept a leading minus sign. -->
                <TextBox AutomationProperties.Name="Value"
                         AutomationProperties.HelpText="Required"
                         Text="{Binding CreateValue, UpdateSourceTrigger=LostFocus}"
                         LostFocus="OnValueTextBoxLostFocus"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding CreateValueFieldError}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Text="{Binding CreateSaveError}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Appearance="Primary" MinWidth="90" Command="{Binding SubmitCreateCommand}">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Add Entry"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelCreateFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
