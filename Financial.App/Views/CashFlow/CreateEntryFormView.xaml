<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.CreateEntryFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.CashFlow">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Text="New Entry" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date:" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding CreateDate, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Currency:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:ControleMaeViewModel.Currencies}"
                      SelectedItem="{Binding CreateCurrency, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CreateDescription, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Note:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CreateNote, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Value:" VerticalAlignment="Center"/>
            <!-- Plain TextBox (not the shared decimal-masked input): the source value may be
                 negative (a debit), so it must accept a leading minus sign. -->
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CreateValue, UpdateSourceTrigger=LostFocus}"
                     LostFocus="OnValueTextBoxLostFocus"/>

            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Text="{Binding CreateSaveError}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Appearance="Primary" MinWidth="90" Command="{Binding SubmitCreateCommand}">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Add Entry"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelCreateFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
