<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.AddBillFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.CashFlow"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        Four equal-width columns, label-above-control per field: mirrors the responsive
        form grid used elsewhere (docs/ui/decisions/ADR-002-responsive-form-layout.md)
        instead of the old single-column label-left/one-field-per-row layout.
    -->
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" FontWeight="Bold" Text="Add Bill" Margin="0,0,0,8"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Area"/>
                <ComboBox AutomationProperties.Name="Area"
                          ItemsSource="{x:Static vm:MensaisViewModel.Areas}"
                          SelectedItem="{Binding NewArea, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Description"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <TextBox AutomationProperties.Name="Description"
                         AutomationProperties.HelpText="Required"
                         Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding NewDescriptionFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Due Day"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <TextBox AutomationProperties.Name="Due day"
                         AutomationProperties.HelpText="Required"
                         Text="{Binding NewDueDay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding NewDueDayFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Value"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <TextBox AutomationProperties.Name="Value"
                         AutomationProperties.HelpText="Required"
                         Text="{Binding NewValue, UpdateSourceTrigger=LostFocus}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding NewValueFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Note"/>
                <TextBox AutomationProperties.Name="Note"
                         Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Text="{Binding AddSaveError}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Appearance="Primary" MinWidth="90" Command="{Binding SubmitAddCommand}">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Add Bill"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                    <Setter Property="Content" Value="Adding Bill..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelAddFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
