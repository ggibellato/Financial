<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.IncomeSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.CashFlow">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:Button Grid.Row="0" Content="New Income" HorizontalAlignment="Left" Margin="0,0,0,8"
                   Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}"
                   Command="{Binding ShowCreateIncomeFormCommand}"/>

        <local:IncomeFormView Grid.Row="1"
                               Visibility="{Binding IsIncomeFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <TextBlock Grid.Row="2" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{Binding DeletingIncomeError}"/>

        <TextBlock Grid.Row="3" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{Binding IncomeSplitConfirmationMessage}"/>

        <DataGrid Grid.Row="4" ItemsSource="{Binding FilteredIncomes}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Date, Converter={StaticResource DateFormatConverter}}" Header="Date" Width="100"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding IncomeSourceName}" Header="Source" Width="140"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding GrossValue, StringFormat=N2, TargetNullValue='—'}" Header="Gross" Width="100"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding NetValue, StringFormat=N2}" Header="Net" Width="100"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                <DataGridTextColumn x:Name="BankColumn" Binding="{Binding BankName, TargetNullValue='—'}" Header="Bank" Width="140"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Appearance="Transparent" Padding="4,0"
                                       Icon="{ui:SymbolIcon Symbol=Edit16}"
                                       ToolTip="Edit income" AutomationProperties.Name="Edit income"
                                       Command="{Binding DataContext.EditIncomeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Appearance="Transparent" Padding="4,0"
                                       Icon="{ui:SymbolIcon Symbol=Delete16}"
                                       ToolTip="Delete income" AutomationProperties.Name="Delete income"
                                       Command="{Binding DataContext.DeleteIncomeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
