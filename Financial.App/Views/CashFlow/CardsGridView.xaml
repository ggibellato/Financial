<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.CardsGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Financial.Presentation.App.Helpers">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="ShowCardManagementColumnsProxy"
                               Data="{Binding ShowCardManagementColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </UserControl.Resources>
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding CreditCardManagementRows}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding CreditCardName}" Header="Card" Width="180"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTemplateColumn Header="Outstanding" SortMemberPath="OutstandingTotal" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Padding="8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumnTextStyle}">
                                        <Setter Property="Text" Value="{Binding OutstandingTotal, StringFormat=N2}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStatement}" Value="False">
                                                <Setter Property="Text" Value="—"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" SortMemberPath="IsPaid" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Padding="8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}">
                                        <Setter Property="Text" Value="Unpaid"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                <Setter Property="Text" Value="Paid"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasStatement}" Value="False">
                                                <Setter Property="Text" Value="—"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStatement}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="Unmark Paid" Padding="4,0" Visibility="Collapsed"
                                        Command="{Binding DataContext.UnmarkStatementPaidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Statement}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel Orientation="Horizontal" Visibility="Visible">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ComboBox x:Name="bankComboBox" Width="120"
                                              ItemsSource="{Binding DataContext.Banks, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="OnBankComboBoxSelectionChanged"/>
                                    <Button Content="Mark Paid" Margin="4,0,0,0" Padding="4,0"
                                            Command="{Binding DataContext.MarkStatementPaidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Statement}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Next Invoice Due Date" SortMemberPath="CreditCard.NextInvoiceDueDate" Width="160"
                                         Visibility="{Binding Data, Source={StaticResource ShowCardManagementColumnsProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding CreditCard.NextInvoiceDueDate, Converter={StaticResource DateOnlyToDateTimeConverter}, Mode=OneWay}"
                                        SelectedDateChanged="OnDueDateChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Active" SortMemberPath="CreditCard.IsActive" Width="60"
                                         Visibility="{Binding Data, Source={StaticResource ShowCardManagementColumnsProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding CreditCard.IsActive, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      Checked="OnActiveChanged" Unchecked="OnActiveChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Combined adjustment figure: "/>
            <TextBlock Text="{Binding AdjustmentTotal, StringFormat=N2}" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding CreditCardUpdateError}"
                   Visibility="{Binding Data, Source={StaticResource ShowCardManagementColumnsProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBlock Grid.Row="3" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding CardStatementError}"/>
        <TextBlock Grid.Row="4" Foreground="#8A6D00" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding CardStatementWarning}"/>
    </Grid>
</UserControl>
