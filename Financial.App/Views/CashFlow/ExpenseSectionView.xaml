<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.ExpenseSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.CashFlow">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent exactly — see the same override in ExpenseFormView.xaml. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:Button Grid.Row="0" Content="New Expense" HorizontalAlignment="Left" Margin="0,0,0,8"
                   Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}"
                   Command="{Binding ShowCreateExpenseFormCommand}" CommandParameter="bank"/>

        <local:ExpenseFormView Grid.Row="1"
                                Visibility="{Binding IsExpenseFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Text="{Binding DeletingExpenseError}"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredExpenses}" AutomationProperties.Name="Expenses"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeRows="False" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Appearance="Transparent" Padding="4,0"
                                       Icon="{ui:SymbolIcon Symbol=Edit16}"
                                       ToolTip="Edit expense" AutomationProperties.Name="Edit expense"
                                       Command="{Binding DataContext.EditExpenseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Appearance="Transparent" Padding="4,0"
                                       Icon="{ui:SymbolIcon Symbol=Delete16}"
                                       ToolTip="Delete expense" AutomationProperties.Name="Delete expense"
                                       Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Date, Converter={StaticResource DateFormatConverter}}" Header="Date" Width="100"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn x:Name="ExpensesCategoryColumn" Binding="{Binding CategoryName}" Header="Category" Width="120"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding Value, StringFormat=N2}" Header="Value" Width="100"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding PaymentSourceBankName}" Header="Payment Source" Width="140"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn x:Name="ExpensesCardColumn" Binding="{Binding CreditCardName}" Header="Card" Width="160"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
