<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.BankSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.CashFlow">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            Grid create/new actions: left-aligned, primary + add icon, same
            style as every other "New X" button under CashFlow/Monthly
            (docs/ui/forms-data-and-visualisations.md) — this tab is the
            reference for POSITION; it now also matches on style.
        -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button Content="New Transfer" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}"
                       Command="{Binding Transfer.ShowMoveMoneyFormCommand}"/>
            <ui:Button Content="Correct Balance" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}"
                       Command="{Binding Adjustment.ShowCorrectBalanceFormCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <local:TransferFormView DataContext="{Binding Transfer}"
                                     Visibility="{Binding IsTransferFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <local:BalanceAdjustmentFormView DataContext="{Binding Adjustment}"
                                              Visibility="{Binding IsAdjustmentFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{Binding BankOperationsError}"/>

        <TextBlock Grid.Row="4" FontStyle="Italic" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Text="{Binding BankOperationsEmptyMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAnyBankOperationsBeforeFilter}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="4" FontStyle="Italic" VerticalAlignment="Top" HorizontalAlignment="Left" Panel.ZIndex="1"
                   Text="No rows match the current filters">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasAnyBankOperationsBeforeFilter}" Value="True"/>
                                <Condition Binding="{Binding HasBankOperations}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DataGrid Grid.Row="4" ItemsSource="{Binding FilteredBankOperations}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAnyBankOperationsBeforeFilter}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Date, Converter={StaticResource DateFormatConverter}}" Header="Date" Width="100"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding Kind}" Header="Type" Width="100"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn x:Name="BankColumn" Binding="{Binding BankLabel}" Header="Bank(s)" Width="180"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding DisplayAmount, StringFormat=N2}" Header="Amount/Delta" Width="120"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding Note}" Header="Note" Width="*"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Transparent" Padding="4,0" Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon Symbol=Edit16}"
                                           ToolTip="Edit transfer" AutomationProperties.Name="Edit transfer"
                                           Command="{Binding DataContext.Transfer.EditTransferCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding Transfer}">
                                    <ui:Button.Style>
                                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Transfer">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Padding="4,0" Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon Symbol=Edit16}"
                                           ToolTip="Edit balance adjustment" AutomationProperties.Name="Edit balance adjustment"
                                           Command="{Binding DataContext.Adjustment.EditAdjustmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding Adjustment}">
                                    <ui:Button.Style>
                                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Adjustment">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Padding="4,0"
                                           Icon="{ui:SymbolIcon Symbol=Delete16}"
                                           ToolTip="Delete" AutomationProperties.Name="Delete"
                                           Command="{Binding DataContext.DeleteBankOperationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
