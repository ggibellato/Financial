<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.BankSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.CashFlow">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Move Money" Command="{Binding ShowMoveMoneyFormCommand}"/>
            <Button Content="Correct Balance" Margin="8,0,0,0" Command="{Binding ShowCorrectBalanceFormCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <local:TransferFormView Visibility="{Binding IsTransferFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <local:BalanceAdjustmentFormView Visibility="{Binding IsAdjustmentFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Bank:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="180" ItemsSource="{Binding BankFilterOptions}"
                      SelectedItem="{Binding SelectedBankFilter}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{Binding BankOperationsError}"/>

        <TextBlock Grid.Row="4" FontStyle="Italic" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Text="{Binding BankOperationsEmptyMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBankOperations}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DataGrid Grid.Row="4" ItemsSource="{Binding FilteredBankOperations}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBankOperations}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏" ToolTip="Edit transfer" Padding="4,0"
                                        Command="{Binding DataContext.EditTransferCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Transfer}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Transfer">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="✏" ToolTip="Edit balance adjustment" Padding="4,0"
                                        Command="{Binding DataContext.EditAdjustmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Adjustment}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Adjustment">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑" ToolTip="Delete" Padding="4,0"
                                    Command="{Binding DataContext.DeleteBankOperationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Header="Date" Width="100"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding Kind}" Header="Type" Width="100"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding BankLabel}" Header="Bank(s)" Width="180"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding DisplayAmount, StringFormat=N2}" Header="Amount/Delta" Width="120"
                                     ElementStyle="{StaticResource NumericColumnTextStyle}"/>
                <DataGridTextColumn Binding="{Binding Note}" Header="Note" Width="*"
                                     ElementStyle="{StaticResource PlainColumnTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
