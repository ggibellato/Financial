<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.EditBillFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.CashFlow"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" FontWeight="Bold" Text="Edit Bill" Margin="0,0,0,8"/>

            <!--
                Row 1 is deliberately empty, reserving the vertical space AddBillFormView's
                Area/Description/Due Day row occupies, so Value (the field this view shares
                with Add) stays pinned to the same absolute row in both views
                (docs/ui/forms-data-and-visualisations.md "Add/Edit variant layout continuity").
            -->

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Value"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <TextBox AutomationProperties.Name="Value"
                         AutomationProperties.HelpText="Required"
                         Text="{Binding EditValue, UpdateSourceTrigger=LostFocus}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding EditValueFieldError}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,8">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Status"/>
                    <Run Text=" *" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </TextBlock>
                <ComboBox AutomationProperties.Name="Status"
                          AutomationProperties.HelpText="Required"
                          ItemsSource="{x:Static vm:MensaisViewModel.Statuses}"
                          SelectedItem="{Binding EditStatus, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldErrorTextStyle}" Text="{Binding EditStatusFieldError}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Text="{Binding EditSaveError}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Appearance="Primary" MinWidth="90" Command="{Binding SaveEditCommand}">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Save"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelEditFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
