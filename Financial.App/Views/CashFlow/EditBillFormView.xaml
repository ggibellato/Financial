<UserControl x:Class="Financial.Presentation.App.Views.CashFlow.EditBillFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.CashFlow"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Text="Edit Bill" Margin="0,0,0,8"/>

            <!--
                Rows 1-3 are deliberately empty, reserving the vertical space
                AddBillFormView's Area/Description/Due Day rows occupy, so Value
                (the field this view shares with Add) stays pinned to the same
                absolute row in both views (docs/ui/forms-data-and-visualisations.md
                "Add/Edit variant layout continuity").
            -->

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Value:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditValue, UpdateSourceTrigger=LostFocus}"
                     behaviors:DecimalInputBehavior.IsEnabled="True"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Status:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:MensaisViewModel.Statuses}"
                      SelectedItem="{Binding EditStatus, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Text="{Binding EditSaveError}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Width="90" Command="{Binding SaveEditCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Save"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Cancel" Width="90" Margin="8,0,0,0" Command="{Binding CancelEditFormCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
