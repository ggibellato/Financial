<Window x:Class="Financial.Presentation.App.Views.Admin.RecurringBillFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Height="620"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Due Day" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1"
                     AutomationProperties.Name="Due Day"
                     Text="{Binding DueDay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Text="Description" Margin="0,0,0,4"/>
            <TextBox Grid.Row="3"
                     AutomationProperties.Name="Description"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="4" Text="Value" Margin="0,0,0,4"/>
            <TextBox Grid.Row="5"
                     AutomationProperties.Name="Value"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="6" Text="Area" Margin="0,0,0,4"/>
            <ComboBox Grid.Row="7"
                      AutomationProperties.Name="Area"
                      ItemsSource="{Binding AreaOptions}"
                      SelectedValue="{Binding Area, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,10"/>

            <TextBlock Grid.Row="8" Text="Note" Margin="0,0,0,4"/>
            <TextBox Grid.Row="9"
                     AutomationProperties.Name="Note"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="10" Text="NIT Number" Margin="0,0,0,4"/>
            <TextBox Grid.Row="11"
                     AutomationProperties.Name="NIT Number"
                     Text="{Binding NitNumber, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="12" Text="Minimum Wage Value" Margin="0,0,0,4"/>
            <TextBox Grid.Row="13"
                     AutomationProperties.Name="Minimum Wage Value"
                     Text="{Binding MinimumWageValue, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <StackPanel Grid.Row="14" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Status" Margin="0,0,0,4"/>
                <ComboBox AutomationProperties.Name="Status"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,10"/>
            </StackPanel>

            <TextBlock Grid.Row="15"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding ValidationMessage}"
                       Margin="0,0,0,10"/>

            <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Save" Width="90" Command="{Binding ConfirmCommand}" IsDefault="True"/>
                <Button Content="Cancel" Width="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
