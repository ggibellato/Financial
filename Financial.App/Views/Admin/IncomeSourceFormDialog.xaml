<Window x:Class="Financial.Presentation.App.Views.Admin.IncomeSourceFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Height="380"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Name" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1"
                 AutomationProperties.Name="Name"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Group" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="3"
                  AutomationProperties.Name="Group"
                  ItemsSource="{Binding GroupOptions}"
                  SelectedValue="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,10"/>

        <CheckBox Grid.Row="4"
                  AutomationProperties.Name="Active"
                  Content="Active"
                  IsChecked="{Binding IsActive}"
                  Margin="0,0,0,10"/>

        <CheckBox Grid.Row="5"
                  AutomationProperties.Name="Auto-split to reserve"
                  Content="Auto-split to reserve"
                  IsChecked="{Binding AutoSplitToReserve}"
                  Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="Save" Appearance="Primary" MinWidth="90" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
