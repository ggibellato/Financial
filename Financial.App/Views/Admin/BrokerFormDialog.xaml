<Window x:Class="Financial.Presentation.App.Views.Admin.BrokerFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Height="340"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Name" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1"
                 AutomationProperties.Name="Name"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Currency" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="3"
                  AutomationProperties.Name="Currency"
                  SelectedValuePath="Content"
                  SelectedValue="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,10">
            <ComboBoxItem Content="BRL"/>
            <ComboBoxItem Content="GBP"/>
            <ComboBoxItem Content="USD"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Text="Cost Basis Method" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="5"
                  AutomationProperties.Name="Cost Basis Method"
                  SelectedValuePath="Content"
                  SelectedValue="{Binding CostBasisMethod, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,4">
            <ComboBoxItem Content="AverageCost"/>
            <ComboBoxItem Content="FIFO"/>
            <ComboBoxItem Content="SpecificId"/>
        </ComboBox>
        <TextBlock Grid.Row="6"
                   Text="Changing this for an existing broker recalculates every disposal record under it."
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="Save" Appearance="Primary" MinWidth="90" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
