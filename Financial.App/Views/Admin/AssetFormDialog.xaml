<Window x:Class="Financial.Presentation.App.Views.Admin.AssetFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Height="620"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Broker" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="1"
                          AutomationProperties.Name="Broker"
                          IsEnabled="{Binding CanChangeBrokerPortfolio}"
                          ItemsSource="{Binding ActiveBrokerNames}"
                          SelectedValue="{Binding BrokerName, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Text="Portfolio" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="3"
                          AutomationProperties.Name="Portfolio"
                          IsEnabled="{Binding CanChangeBrokerPortfolio}"
                          ItemsSource="{Binding PortfolioNames}"
                          SelectedValue="{Binding PortfolioName, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Text="Name" Margin="0,0,0,4"/>
                <TextBox Grid.Row="5"
                         AutomationProperties.Name="Name"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"/>

                <TextBlock Grid.Row="6" Text="ISIN" Margin="0,0,0,4"/>
                <TextBox Grid.Row="7"
                         AutomationProperties.Name="ISIN"
                         Text="{Binding ISIN, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"/>

                <TextBlock Grid.Row="8" Text="Exchange" Margin="0,0,0,4"/>
                <TextBox Grid.Row="9"
                         AutomationProperties.Name="Exchange"
                         Text="{Binding Exchange, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"/>

                <TextBlock Grid.Row="10" Text="Ticker" Margin="0,0,0,4"/>
                <TextBox Grid.Row="11"
                         AutomationProperties.Name="Ticker"
                         Text="{Binding Ticker, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"/>

                <TextBlock Grid.Row="12" Text="Country" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="13"
                          AutomationProperties.Name="Country"
                          ItemsSource="{Binding CountryOptions}"
                          SelectedValue="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,10"/>

                <TextBlock Grid.Row="14" Text="Local Type Code" Margin="0,0,0,4"/>
                <TextBox Grid.Row="15"
                         AutomationProperties.Name="Local Type Code"
                         Text="{Binding LocalTypeCode, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"/>

                <TextBlock Grid.Row="16" Text="Class" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="17"
                          AutomationProperties.Name="Class"
                          ItemsSource="{Binding ClassOptions}"
                          SelectedValue="{Binding Class, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,10"/>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}"
                   Margin="0,10,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <ui:Button Content="Save" Appearance="Primary" MinWidth="90" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
