<UserControl x:Class="Financial.Presentation.App.Views.Admin.AssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent exactly — see the same override in ExpenseFormView.xaml. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Loading..." FontSize="14"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
            <Button Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="0" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Assets" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Content="Create Asset" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}" Command="{Binding CreateAssetCommand}"/>
                <TextBlock Text="{Binding ActionError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding ActionError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Broker:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox AutomationProperties.Name="Filter by broker" Width="140"
                          ItemsSource="{Binding BrokerFilterOptions}"
                          SelectedValue="{Binding BrokerFilter, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,16,0"/>
                <TextBlock Text="Portfolio:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox AutomationProperties.Name="Filter by portfolio" Width="140"
                          ItemsSource="{Binding PortfolioFilterOptions}"
                          SelectedValue="{Binding PortfolioFilter, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,16,0"/>
                <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox AutomationProperties.Name="Filter by class" Width="140"
                          ItemsSource="{Binding ClassFilterOptions}"
                          SelectedValue="{Binding ClassFilter, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Assets}" AutoGenerateColumns="False" IsReadOnly="True"
                      AutomationProperties.Name="Assets">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="*"/>
                    <DataGridTextColumn Binding="{Binding Ticker}" Header="Ticker" Width="100"/>
                    <DataGridTextColumn Binding="{Binding BrokerName}" Header="Broker" Width="120"/>
                    <DataGridTextColumn Binding="{Binding PortfolioName}" Header="Portfolio" Width="120"/>
                    <DataGridTextColumn Binding="{Binding Class}" Header="Class" Width="100"/>
                    <DataGridTextColumn Binding="{Binding Quantity, StringFormat=N8}" Header="Quantity" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumnTextStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Appearance="Transparent" Padding="4,0"
                                           Icon="{ui:SymbolIcon Symbol=Edit16}"
                                           ToolTip="Edit" AutomationProperties.Name="Edit"
                                           Command="{Binding DataContext.EditAssetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Appearance="Transparent" Padding="4,0"
                                           Icon="{ui:SymbolIcon Symbol=Delete16}"
                                           ToolTip="Delete" AutomationProperties.Name="Delete"
                                           Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
