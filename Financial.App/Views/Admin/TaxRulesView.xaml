<UserControl x:Class="Financial.Presentation.App.Views.Admin.TaxRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent exactly — see the same override in ExpenseFormView.xaml. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Loading..." FontSize="14"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
            <Button Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="0" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Tax Rules" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Content="Create Tax Rule" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}" Command="{Binding CreateTaxRuleCommand}"/>
                <TextBlock Text="{Binding ActionError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding ActionError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="No tax rules configured yet — create one to get started."
                       Visibility="{Binding HasNoTaxRules, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <DataGrid Grid.Row="2" ItemsSource="{Binding TaxRules}" AutoGenerateColumns="False" IsReadOnly="True"
                      AutomationProperties.Name="Tax Rules"
                      Visibility="{Binding ShowTaxRules, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Jurisdiction}" Header="Jurisdiction" Width="100"
                                         ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                    <DataGridTextColumn Binding="{Binding EventCategory}" Header="Event Category" Width="160"
                                         ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                    <DataGridTextColumn Binding="{Binding Label}" Header="Label" Width="*"
                                         ElementStyle="{StaticResource TruncatedColumnTextStyle}"/>
                    <DataGridTextColumn Binding="{Binding EffectiveFrom}" Header="Effective From" Width="110"
                                         ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                    <DataGridTextColumn Binding="{Binding EffectiveTo, TargetNullValue='—'}" Header="Effective To" Width="110"
                                         ElementStyle="{StaticResource PlainColumnTextStyle}"/>
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Appearance="Transparent" Padding="4,0" Margin="0,0,4,0"
                                               Icon="{ui:SymbolIcon Symbol=Edit16}"
                                               ToolTip="Edit" AutomationProperties.Name="Edit"
                                               Command="{Binding DataContext.EditTaxRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Appearance="Transparent" Padding="4,0"
                                               Icon="{ui:SymbolIcon Symbol=Delete16}"
                                               ToolTip="Delete" AutomationProperties.Name="Delete"
                                               Command="{Binding DataContext.DeleteTaxRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
