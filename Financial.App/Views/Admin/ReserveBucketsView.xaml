<UserControl x:Class="Financial.Presentation.App.Views.Admin.ReserveBucketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Loading..." FontSize="14"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>
            <Button Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="0" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Reserve Buckets" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Create Reserve Bucket" Command="{Binding CreateReserveBucketCommand}"/>
                <TextBlock Text="{Binding ActionError}" Foreground="Red" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding ActionError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{Binding SplitPercentageWarning}" Foreground="#B25E00" TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="{Binding SplitPercentageWarning, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>

            <DataGrid Grid.Row="3" ItemsSource="{Binding ReserveBuckets}" AutoGenerateColumns="False" IsReadOnly="True"
                      AutomationProperties.Name="Reserve Buckets">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✏" ToolTip="Edit" Padding="4,0"
                                        Command="{Binding DataContext.EditReserveBucketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" ToolTip="Delete" Padding="4,0"
                                        IsEnabled="{Binding IsActive}"
                                        Command="{Binding DataContext.DeactivateReserveBucketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="*"/>
                    <DataGridTextColumn Binding="{Binding SplitPercentage}" Header="Split Percentage" Width="130"/>
                    <DataGridTextColumn Binding="{Binding IsActive}" Header="Active" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
