<Window x:Class="Financial.Presentation.App.Views.Admin.ReserveBucketFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Height="360"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Name" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1"
                 AutomationProperties.Name="Name"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Split Percentage" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3"
                 AutomationProperties.Name="Split Percentage"
                 Text="{Binding SplitPercentage, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"/>

        <CheckBox Grid.Row="4"
                  AutomationProperties.Name="Active"
                  Content="Active"
                  IsChecked="{Binding IsActive}"
                  Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Width="90" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
