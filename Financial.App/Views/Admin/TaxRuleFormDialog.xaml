<Window x:Class="Financial.Presentation.App.Views.Admin.TaxRuleFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Height="480"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Jurisdiction" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="1"
                  AutomationProperties.Name="Jurisdiction"
                  ItemsSource="{Binding Jurisdictions}"
                  SelectedItem="{Binding Jurisdiction}"
                  IsEnabled="{Binding IsCreateMode}"
                  Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Event Category" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="3"
                  AutomationProperties.Name="Event Category"
                  ItemsSource="{Binding EventCategories}"
                  SelectedItem="{Binding EventCategory}"
                  IsEnabled="{Binding IsCreateMode}"
                  Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Label" Margin="0,0,0,4"/>
        <TextBox Grid.Row="5"
                 AutomationProperties.Name="Label"
                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Text="Description" Margin="0,0,0,4"/>
        <TextBox Grid.Row="7"
                 AutomationProperties.Name="Description"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="60"
                 Margin="0,0,0,10"/>

        <Grid Grid.Row="8" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Effective From" Margin="0,0,0,4"/>
                <DatePicker AutomationProperties.Name="Effective From"
                            SelectedDate="{Binding EffectiveFrom, Converter={StaticResource DateOnlyToDateTimeConverter}}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Effective To" Margin="0,0,0,4"/>
                <DatePicker AutomationProperties.Name="Effective To"
                            SelectedDate="{Binding EffectiveTo, Converter={StaticResource DateOnlyToDateTimeConverter}}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="9"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="Save" Appearance="Primary" MinWidth="90" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
