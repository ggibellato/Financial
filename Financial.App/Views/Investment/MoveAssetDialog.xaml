<Window x:Class="Financial.Presentation.App.Views.Investment.MoveAssetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Height="360"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,12">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} / {1} / {2}">
                    <Binding Path="BrokerName"/>
                    <Binding Path="PortfolioName"/>
                    <Binding Path="AssetName"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Only a closed position in Active Investments can be archived, so the choice appears
             only then. An asset never comes back out of Historic. -->
        <StackPanel Grid.Row="1"
                    Visibility="{Binding CanArchive, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,0,0,10">
            <TextBlock Text="Destination:" Margin="0,0,0,4"/>
            <RadioButton GroupName="Scope"
                         Content="Keep in Active Investments"
                         IsChecked="{Binding KeepInCurrentScope}"
                         Margin="0,0,0,2"/>
            <RadioButton GroupName="Scope"
                         Content="Archive to Historic Investments"
                         IsChecked="{Binding ArchiveToHistoric}"/>
        </StackPanel>

        <RadioButton Grid.Row="2"
                     GroupName="Destination"
                     Content="Move to an existing portfolio"
                     IsChecked="{Binding UseExistingPortfolio}"
                     IsEnabled="{Binding HasExistingDestination}"
                     Margin="0,0,0,4"/>

        <ComboBox Grid.Row="3"
                  AutomationProperties.Name="Destination portfolio"
                  ItemsSource="{Binding AvailablePortfolios}"
                  SelectedItem="{Binding SelectedPortfolioName, UpdateSourceTrigger=PropertyChanged}"
                  IsEnabled="{Binding UseExistingPortfolio}"
                  Margin="20,0,0,12"/>

        <RadioButton Grid.Row="4"
                     GroupName="Destination"
                     Content="Move to a new portfolio"
                     IsChecked="{Binding CreateNewPortfolio}"
                     Margin="0,0,0,4"/>

        <TextBox Grid.Row="5"
                 AutomationProperties.Name="New portfolio name"
                 Text="{Binding NewPortfolioName, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CreateNewPortfolio}"
                 Margin="20,0,0,0"/>

        <TextBlock Grid.Row="6"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}"
                   Margin="0,8,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Move" Width="90" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
