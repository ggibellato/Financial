<UserControl x:Class="Financial.Presentation.App.Views.Investment.PortfolioFooterStat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!--
        One "Label: Value" footer stat, used for the 4 of 5 footer items that share
        this exact shape across PortfolioSummaryTemplate and PortfolioSummaryTemplateHistoric
        (the 5th, Current Value / Realized Gain-Loss, differs per template and stays inline).
        Label/Value are set per usage, including as bindings against the host template's
        ambient DataContext, so each stays an independently wrappable WrapPanel child.
    -->
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Label, ElementName=Root}" FontWeight="Bold" Margin="0,0,5,0"/>
        <TextBlock Text="{Binding Value, ElementName=Root}" FontFamily="Consolas"/>
    </StackPanel>
</UserControl>
