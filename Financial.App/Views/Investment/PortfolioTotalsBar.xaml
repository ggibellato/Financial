<UserControl x:Class="Financial.Presentation.App.Views.Investment.PortfolioTotalsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared "Total Bought/Sold/Credits/Invested" row for PortfolioSummaryTemplate
        and PortfolioSummaryTemplateHistoric — was duplicated verbatim in both. Binds
        against the ambient AssetDetails.* DataContext inherited from the host template.
    -->
    <StackPanel Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Total Bought:" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding AssetDetails.TotalBought, Mode=OneWay, StringFormat=N2}"
                       FontFamily="Consolas" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,20,0"/>
            <TextBlock Text="Total Sold:" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding AssetDetails.TotalSold, Mode=OneWay, StringFormat=N2}"
                       FontFamily="Consolas" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,20,0"/>
            <TextBlock Text="Total Credits:" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding AssetDetails.TotalCredits, Mode=OneWay, StringFormat=N2}"
                       FontFamily="Consolas" Foreground="Blue" Margin="0,0,20,0"/>
            <TextBlock Text="Total Invested:" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding AssetDetails.TotalInvested, Mode=OneWay, StringFormat=N2}"
                       FontFamily="Consolas"
                       Foreground="{Binding AssetDetails.TotalInvested, Converter={StaticResource SignedValueToBrushConverter}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Market Value:" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding AssetDetails.MarketValue, Mode=OneWay, StringFormat=N2, TargetNullValue='—'}"
                       FontFamily="Consolas" Margin="0,0,20,0"/>
            <TextBlock Text="Price-Only Return:" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding AssetDetails.PriceOnlyReturn, Mode=OneWay, StringFormat=P2, TargetNullValue='—'}"
                       FontFamily="Consolas"
                       Foreground="{Binding AssetDetails.PriceOnlyReturn, Converter={StaticResource SignedValueToBrushConverter}}"
                       Margin="0,0,20,0"/>
            <TextBlock Text="Total Return:" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding AssetDetails.TotalReturn, Mode=OneWay, StringFormat=P2, TargetNullValue='—'}"
                       FontFamily="Consolas"
                       Foreground="{Binding AssetDetails.TotalReturn, Converter={StaticResource SignedValueToBrushConverter}}"/>
        </StackPanel>
        <TextBlock Text="{Binding AssetDetails.IncompleteValuationMessage, Mode=OneWay}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding AssetDetails.HasIncompleteValuation, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Margin="0,10,0,0"
                    Visibility="{Binding AssetDetails.IsReportingCurrencyAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Some figures could not be converted; showing a partial total."
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding AssetDetails.IsPartial, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AssetDetails.ReportingCurrency, StringFormat='Invested (converted to {0}):'}" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding AssetDetails.ConvertedInvested, Mode=OneWay, StringFormat=N2, TargetNullValue='—'}"
                           FontFamily="Consolas"
                           Foreground="{Binding AssetDetails.ConvertedInvested, Converter={StaticResource SignedValueToBrushConverter}}"
                           Margin="0,0,20,0"/>
                <TextBlock Text="{Binding AssetDetails.ReportingCurrency, StringFormat='Market Value (converted to {0}):'}" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding AssetDetails.ConvertedMarketValue, Mode=OneWay, StringFormat=N2, TargetNullValue='—'}"
                           FontFamily="Consolas"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{Binding AssetDetails.ReportingCurrency, StringFormat='Unrealised Gain/Loss (converted to {0}):'}" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding AssetDetails.ConvertedUnrealisedGainLoss, Mode=OneWay, StringFormat=N2, TargetNullValue='—'}"
                           FontFamily="Consolas"
                           Foreground="{Binding AssetDetails.ConvertedUnrealisedGainLoss, Converter={StaticResource SignedValueToBrushConverter}}"
                           Margin="0,0,20,0"/>
                <TextBlock Text="{Binding AssetDetails.ReportingCurrency, StringFormat='Total Return (converted to {0}):'}" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding AssetDetails.ConvertedTotalReturn, Mode=OneWay, StringFormat=P2, TargetNullValue='—'}"
                           FontFamily="Consolas"
                           Foreground="{Binding AssetDetails.ConvertedTotalReturn, Converter={StaticResource SignedValueToBrushConverter}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{Binding AssetDetails.ReportingCurrency, StringFormat='Total Return Net of Tax (converted to {0}):'}" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding AssetDetails.ConvertedTotalReturnNetOfTax, Mode=OneWay, StringFormat=P2, TargetNullValue='—'}"
                           FontFamily="Consolas"
                           Foreground="{Binding AssetDetails.ConvertedTotalReturnNetOfTax, Converter={StaticResource SignedValueToBrushConverter}}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Converted totals unavailable — showing native-currency figures only."
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding AssetDetails.IsReportingCurrencyUnavailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </StackPanel>
</UserControl>
