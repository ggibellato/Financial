<UserControl x:Class="Financial.Presentation.App.Views.Investment.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.Investment">
    <!--
        Layout follows docs/ui/forms-data-and-visualisations.md's "Grid-and-chart
        pages" rule: filters/mode controls at the top, then stacked (chart above,
        grid below) — mirrors Financial.Web's CreditsTab.tsx's current stacked
        layout (toolbar, chart, "New credit" button, grid), the same pattern
        TransactionsView.xaml's TransactionsAssetTemplate already uses.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        <DataTemplate x:Key="CreditsAssetTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <local:CreditsFilterBar Grid.Row="0" Margin="0,0,0,8"/>

                <oxy:PlotView Grid.Row="1"
                              Background="Transparent"
                              Model="{Binding AssetDetails.Credits.CreditsPlotModel}"
                              SizeChanged="OnCreditsPlotSizeChanged" />

                <GridSplitter Grid.Row="2"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"/>

                <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,8,0,8">
                    <ui:Button Content="New credit" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}"
                               ToolTip="New credit"
                               Command="{Binding AssetDetails.Credits.AddCreditCommand}"/>
                </StackPanel>

                <!--
                    Visibility must bind at THIS Grid's own (inherited) DataContext,
                    not CreditFormView's — a Binding and a DataContext override on
                    the SAME element resolve the Binding against the new local
                    DataContext, not the inherited one, so Visibility would silently
                    fail to resolve and the form would never collapse. See
                    docs/ui/wpf.md.
                -->
                <Grid Grid.Row="4"
                      Visibility="{Binding AssetDetails.Credits.IsCreditFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <local:CreditFormView DataContext="{Binding AssetDetails.Credits.CreditFormViewModel}"/>
                </Grid>

                <DataGrid Grid.Row="5"
                          ItemsSource="{Binding AssetDetails.Credits.Credits}"
                          SelectedItem="{Binding AssetDetails.Credits.SelectedCredit, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding AssetDetails.Credits.UpdateCreditCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding Date, Converter={StaticResource DateFormatConverter}, ConverterParameter='d'}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding Type}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value, StringFormat=N2}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumnTextStyle}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Yield (Bought)"
                                            Binding="{Binding YieldOnInvested, StringFormat={}{0:N1}%, TargetNullValue='—'}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumnTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Yield (Current)"
                                            Binding="{Binding YieldOnMarket, StringFormat={}{0:N1}%, TargetNullValue='—'}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumnTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:SymbolIcon Symbol="Info16"
                                                   AutomationProperties.Name="Dividend yield details"
                                                   Visibility="{Binding SharesForDividend, Converter={StaticResource SharesForDividendToVisibilityConverter}}">
                                        <ui:SymbolIcon.ToolTip>
                                            <MultiBinding Converter="{StaticResource DividendAttributionToTooltipConverter}">
                                                <Binding Path="SharesForDividend"/>
                                                <Binding Path="AverageCostPerShare"/>
                                                <Binding Path="InvestedAmount"/>
                                                <Binding Path="PriceOnDate"/>
                                                <Binding Path="MarketValueOnDate"/>
                                                <Binding Path="Date"/>
                                            </MultiBinding>
                                        </ui:SymbolIcon.ToolTip>
                                    </ui:SymbolIcon>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="FX" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:SymbolIcon Symbol="Info16"
                                                   AutomationProperties.Name="FX conversion details"
                                                   Visibility="{Binding FxRateSnapshot, Converter={StaticResource FxRateSnapshotToVisibilityConverter}}">
                                        <ui:SymbolIcon.ToolTip>
                                            <MultiBinding Converter="{StaticResource FxRateSnapshotToTooltipConverter}">
                                                <Binding Path="Currency"/>
                                                <Binding Path="FxRateSnapshot"/>
                                            </MultiBinding>
                                        </ui:SymbolIcon.ToolTip>
                                    </ui:SymbolIcon>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon Symbol=Edit16}"
                                                   Command="{Binding DataContext.AssetDetails.Credits.UpdateCreditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Update" AutomationProperties.Name="Update"
                                                   Padding="2"
                                                   Margin="0,0,4,0"/>
                                        <ui:Button Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon Symbol=Delete16}"
                                                   Command="{Binding DataContext.AssetDetails.Credits.DeleteCreditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Delete" AutomationProperties.Name="Delete"
                                                   Padding="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CreditsAggregateTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <local:CreditsFilterBar Grid.Row="0" Margin="0,0,0,8"/>

                <oxy:PlotView Grid.Row="1"
                              Background="Transparent"
                              Model="{Binding AssetDetails.Credits.CreditsPlotModel}"
                              SizeChanged="OnCreditsPlotSizeChanged" />
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ContentControl Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate" Value="{StaticResource CreditsAssetTemplate}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AssetDetails.Credits.IsCreditsAggregateView}" Value="True">
                        <Setter Property="ContentTemplate" Value="{StaticResource CreditsAggregateTemplate}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
</UserControl>
