<UserControl x:Class="Financial.Presentation.App.Views.Investment.PriceHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.Investment">
    <!--
        Layout follows docs/ui/forms-data-and-visualisations.md's "Grid-and-chart
        pages" rule: filters at the top, then side by side (grid has few enough
        columns to fit a fixed left panel) — mirrors Financial.Web's
        PriceHistoryTab.tsx (toolbar, then SplitPanel left=grid/right=chart).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding AssetDetails.PriceHistory.PriceHistoryFilters}"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.AssetDetails.PriceHistory.SelectPriceHistoryFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,0"
                            Margin="0,0,12,0">
                        <TextBlock Text="{Binding Label}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#007ACC"/>
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="TextDecorations" Value="{x:Null}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                    <ui:Button Content="New price" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}"
                               ToolTip="New price"
                               Command="{Binding AssetDetails.PriceHistory.AddPriceCommand}"/>
                </StackPanel>

                <!--
                    Visibility must bind at THIS Grid's own (inherited) DataContext, not
                    PriceFormView's — a Binding and a DataContext override on the SAME
                    element resolve the Binding against the new local DataContext, not
                    the inherited one, so Visibility would silently fail to resolve and
                    the form would never collapse. See docs/ui/wpf.md.
                -->
                <Grid Grid.Row="1"
                      Visibility="{Binding AssetDetails.PriceHistory.IsPriceFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <local:PriceFormView DataContext="{Binding AssetDetails.PriceHistory.PriceFormViewModel}"/>
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding AssetDetails.PriceHistory.PriceHistory}"
                          SelectedItem="{Binding AssetDetails.PriceHistory.SelectedPriceEntry, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding AssetDetails.PriceHistory.UpdatePriceCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon Symbol=Edit16}"
                                                   Command="{Binding DataContext.AssetDetails.PriceHistory.UpdatePriceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Update" AutomationProperties.Name="Update"
                                                   Padding="2"
                                                   Margin="0,0,4,0"
                                                   Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ui:Button Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon Symbol=Delete16}"
                                                   Command="{Binding DataContext.AssetDetails.PriceHistory.DeletePriceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Delete" AutomationProperties.Name="Delete"
                                                   Padding="2"
                                                   Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding Date, Converter={StaticResource DateFormatConverter}, ConverterParameter='d'}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Price"
                                            Binding="{Binding Price, StringFormat=N2}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericColumnTextStyle}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Source" SortMemberPath="IsManual" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}">
                                                <Setter Property="Text" Value="Automatic"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                        <Setter Property="Text" Value="Manual"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          VerticalAlignment="Stretch"
                          Background="#E0E0E0"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <oxy:PlotView Grid.Column="2"
                          Background="Transparent"
                          Model="{Binding AssetDetails.PriceHistory.PriceHistoryPlotModel}"/>
        </Grid>
    </Grid>
</UserControl>
