<UserControl x:Class="Financial.Presentation.App.Views.Investment.CorporateActionFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors"
             xmlns:controls="clr-namespace:Financial.Presentation.App.Controls">
    <!--
        Inline form for the "New"/edit corporate action action, mirroring TransactionFormView's
        conversion from a popup Window per docs/ui/forms-data-and-visualisations.md's "'New X'
        create actions are inline forms, not popup dialogs" rule. Bound directly to a
        CorporateActionFormViewModel instance (AssetDetails.CorporateActions.FormViewModel) set
        as this control's own DataContext by its host view, not the surrounding page's DataContext.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" FontWeight="Bold" Margin="0,0,0,8"
                       Text="{Binding Title}"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Effective Date" Style="{StaticResource FieldLabelStyle}"/>
                <DatePicker AutomationProperties.Name="Effective date"
                            SelectedDate="{Binding EffectiveDate, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsEditable}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                <TextBlock Text="Type" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox AutomationProperties.Name="Type"
                          SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag"
                          IsEnabled="{Binding CanChangeType}">
                    <ComboBoxItem Content="Split / Reverse Split" Tag="Split"/>
                    <ComboBoxItem Content="Merger" Tag="Merger"/>
                    <ComboBoxItem Content="Spin-off" Tag="SpinOff"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,8"
                        Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="New units" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="New units"
                         Text="{Binding RatioNumerator, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"
                        Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Old units" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Old units"
                         Text="{Binding RatioDenominator, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibilityConverter}}"
                       Text="e.g. 2 new for 1 old is a 2-for-1 split; 1 new for 10 old is a 1-for-10 reverse split."/>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8"
                        Visibility="{Binding IsMergerFieldsStep, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Source Asset" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Source asset"
                         Text="{Binding SourceAssetName, Mode=OneWay}"
                         IsReadOnly="True"/>
            </StackPanel>

            <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,8,8"
                  Visibility="{Binding IsMergerFieldsStep, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:TargetAssetPickerControl DataContext="{Binding TargetAssetPicker}" Label="Target Asset"/>
                </Grid>
                <Grid Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Target Asset" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox AutomationProperties.Name="Target asset"
                                 Text="{Binding TargetAssetName, Mode=OneWay}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,8,8"
                        Visibility="{Binding IsMergerFieldsStep, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Exchange Ratio" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Exchange ratio"
                         Text="{Binding ExchangeRatio, UpdateSourceTrigger=LostFocus}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,0,0,8"
                        Visibility="{Binding IsMergerFieldsStep, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Cash-in-Lieu Amount" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Cash-in-lieu amount"
                         Text="{Binding CashInLieuAmount, UpdateSourceTrigger=LostFocus}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8"
                        Visibility="{Binding IsSpinOff, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Parent Asset" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Parent asset"
                         Text="{Binding SourceAssetName, Mode=OneWay}"
                         IsReadOnly="True"/>
            </StackPanel>

            <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,8,8"
                  Visibility="{Binding IsSpinOff, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:TargetAssetPickerControl DataContext="{Binding TargetAssetPicker}" Label="New Asset"/>
                </Grid>
                <Grid Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="New Asset" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox AutomationProperties.Name="New asset"
                                 Text="{Binding TargetAssetName, Mode=OneWay}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,8,8"
                        Visibility="{Binding IsSpinOff, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Quantity Received" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Quantity received"
                         Text="{Binding QuantityReceived, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,0,0,8"
                        Visibility="{Binding IsSpinOff, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Allocation %" Style="{StaticResource FieldLabelStyle}"/>
                    <controls:HelpFlyoutButton Margin="4,-4,0,0"
                        HelpText="Find this on your broker's cost-basis allocation letter for this spin-off."/>
                </StackPanel>
                <TextBox AutomationProperties.Name="Allocation percentage"
                         Text="{Binding AllocationPercentage, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
            </StackPanel>

            <WrapPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,0,0,8"
                       Visibility="{Binding IsSpinOff, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding SpinOffStaysWithParentAmount, Mode=OneWay}" FontWeight="Bold"/>
                <TextBlock Text=" stays with "/>
                <TextBlock Text="{Binding SourceAssetName, Mode=OneWay}"/>
                <TextBlock Text=", "/>
                <TextBlock Text="{Binding SpinOffMovesToNewAmount, Mode=OneWay}" FontWeight="Bold"/>
                <TextBlock Text=" moves to "/>
                <TextBlock Text="{Binding SpinOffNewAssetDisplayName, Mode=OneWay}"/>
                <TextBlock Text="."/>
            </WrapPanel>

            <Border Grid.Row="4" Grid.ColumnSpan="4" Margin="0,0,0,8" Padding="12" CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding IsMergerConfirmStep, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- WrapPanel of TextBlocks, not a single TextBlock's Run.Text bindings - docs/ui/wpf.md's
                     "keep totals distinct" rule: Run.Text defaults to TwoWay and risks crashing on a
                     read-only bound property, unlike TextBlock.Text, which defaults to OneWay. -->
                <WrapPanel AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding ConfirmSummary}">
                    <TextBlock Text="Your position in "/>
                    <TextBlock Text="{Binding SourceAssetName, Mode=OneWay}"/>
                    <TextBlock Text=" ("/>
                    <TextBlock Text="{Binding SourceQuantity, Mode=OneWay, StringFormat={}{0:N2}}"/>
                    <TextBlock Text=" units) will close and convert into "/>
                    <TextBlock Text="{Binding ConfirmSummaryTargetUnits, Mode=OneWay}" FontWeight="Bold"/>
                    <TextBlock Text=" of "/>
                    <TextBlock Text="{Binding TargetAssetDisplayName, Mode=OneWay}"/>
                    <TextBlock Text=", carrying over "/>
                    <TextBlock Text="{Binding ConfirmSummaryCostBasis, Mode=OneWay}" FontWeight="Bold"/>
                    <TextBlock Text=" of cost basis."/>
                </WrapPanel>
            </Border>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Margin="0,0,0,8"
                        Visibility="{Binding ShowNote, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Note" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Note"
                         Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="60"/>
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding ValidationMessage}"/>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="4" Orientation="Horizontal">
                <ui:Button Content="{Binding ConfirmLabel}" MinWidth="90" Appearance="Primary"
                           Command="{Binding ConfirmCommand}"/>
                <ui:Button Content="Back" MinWidth="90" Margin="8,0,0,0" Appearance="Secondary"
                           Command="{Binding BackCommand}"
                           Visibility="{Binding IsMergerConfirmStep, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ui:Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" Appearance="Secondary"
                           Command="{Binding CancelCommand}"
                           Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
