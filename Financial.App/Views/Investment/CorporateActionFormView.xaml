<UserControl x:Class="Financial.Presentation.App.Views.Investment.CorporateActionFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors">
    <!--
        Inline form for the "New"/edit corporate action action, mirroring TransactionFormView's
        conversion from a popup Window per docs/ui/forms-data-and-visualisations.md's "'New X'
        create actions are inline forms, not popup dialogs" rule. Bound directly to a
        CorporateActionFormViewModel instance (AssetDetails.CorporateActions.FormViewModel) set
        as this control's own DataContext by its host view, not the surrounding page's DataContext.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" FontWeight="Bold" Margin="0,0,0,8"
                       Text="{Binding Title}"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Effective Date" Style="{StaticResource FieldLabelStyle}"/>
                <DatePicker AutomationProperties.Name="Effective date"
                            SelectedDate="{Binding EffectiveDate, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsEditable}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                <TextBlock Text="Type" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox AutomationProperties.Name="Type"
                          SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag"
                          IsEnabled="{Binding IsEditable}">
                    <ComboBoxItem Content="Split / Reverse Split" Tag="Split"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,8">
                <TextBlock Text="New units" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="New units"
                         Text="{Binding RatioNumerator, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                <TextBlock Text="Old units" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Old units"
                         Text="{Binding RatioDenominator, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         behaviors:DecimalInputBehavior.IsEnabled="True"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="e.g. 2 new for 1 old is a 2-for-1 split; 1 new for 10 old is a 1-for-10 reverse split."/>

            <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Margin="0,0,0,8">
                <TextBlock Text="Note" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox AutomationProperties.Name="Note"
                         Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="60"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding ValidationMessage}"/>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal">
                <ui:Button Content="{Binding ConfirmLabel}" MinWidth="90" Appearance="Primary"
                           Command="{Binding ConfirmCommand}"/>
                <ui:Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" Appearance="Secondary"
                           Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
