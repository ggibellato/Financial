<UserControl x:Class="Financial.Presentation.App.Views.Investment.CreditsFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared "View / Group / Filters" toolbar for CreditsView's asset and
        aggregate templates — was duplicated verbatim in both. Binds against
        the ambient AssetDetails.Credits.* DataContext inherited from the host
        template, same as the rest of CreditsView.
    -->
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="View:" Style="{StaticResource FilterToggleLabelStyle}"/>
            <ItemsControl ItemsSource="{Binding AssetDetails.Credits.CreditsChartTypes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.AssetDetails.Credits.SelectCreditsChartTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,0"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FilterToggleTextStyle}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Group:" Style="{StaticResource FilterToggleLabelStyle}"/>
            <ItemsControl ItemsSource="{Binding AssetDetails.Credits.CreditsTypeModes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.AssetDetails.Credits.SelectCreditsTypeModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,0"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FilterToggleTextStyle}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding AssetDetails.Credits.CreditsFilters}"
                      HorizontalAlignment="Left"
                      Margin="0,6,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.AssetDetails.Credits.SelectCreditsFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,0"
                            Margin="0,0,12,0">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource FilterToggleTextStyle}"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
