<UserControl x:Class="Financial.Presentation.App.Views.Investment.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:dashboard="clr-namespace:Financial.Presentation.App.Views.Investment.Dashboard"
             xmlns:currencies="clr-namespace:Financial.Shared.Abstractions.Currencies;assembly=Financial.Shared.Abstractions">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DashboardHeading" Grid.Column="0" Text="Dashboard" FontSize="20" FontWeight="Bold"
                       Focusable="True" KeyboardNavigation.IsTabStop="False"
                       AutomationProperties.HeadingLevel="Level2"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Display currency" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <RadioButton GroupName="DashboardDisplayCurrency" Content="GBP"
                             IsChecked="{Binding IsGbpSelected}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <RadioButton GroupName="DashboardDisplayCurrency" Content="BRL"
                             IsChecked="{Binding IsBrlSelected}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <RadioButton GroupName="DashboardDisplayCurrency" Content="USD"
                             IsChecked="{Binding IsUsdSelected}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <TextBlock Text="Brokers" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding BrokerCurrencyFilter}"
                          AutomationProperties.Name="Broker currency filter" MinWidth="120"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="All currencies" Tag="{x:Null}"/>
                    <ComboBoxItem Content="BRL" Tag="{x:Static currencies:Currency.BRL}"/>
                    <ComboBoxItem Content="GBP" Tag="{x:Static currencies:Currency.GBP}"/>
                    <ComboBoxItem Content="USD" Tag="{x:Static currencies:Currency.USD}"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Top"
                    Visibility="{Binding ShowPageLevelError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Unable to load the dashboard — none of its data could be retrieved."
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive"/>
            <ui:Button Content="Retry" Appearance="Primary"
                       Command="{Binding RetryAllCommand}"
                       HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowPanels, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Portfolio Summary" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"
                           AutomationProperties.HeadingLevel="Level3"/>
                <dashboard:DashboardKpiTilesView DataContext="{Binding KpiTiles}"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Allocation Breakdown" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"
                                   AutomationProperties.HeadingLevel="Level3"/>
                        <dashboard:AllocationBreakdownView DataContext="{Binding Allocation}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Data Quality Warnings" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"
                                   AutomationProperties.HeadingLevel="Level3"/>
                        <dashboard:DataQualityWarningsView DataContext="{Binding Warnings}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Upcoming Income" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"
                               AutomationProperties.HeadingLevel="Level3"/>
                    <dashboard:UpcomingIncomeView DataContext="{Binding Income}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
