<UserControl x:Class="Financial.Presentation.App.Views.Investment.CorporateActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors"
             xmlns:local="clr-namespace:Financial.Presentation.App.Views.Investment">
    <!-- Mirrors Financial.Web's CorporateActionsTab.tsx: "New corporate action" trigger, inline
         form, then the history grid — no chart, no aggregate view (asset-only tab). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent — see ExpenseFormView.xaml / ADR-005. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <ui:Button Content="New corporate action" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add20}"
                       ToolTip="New corporate action"
                       Command="{Binding AssetDetails.CorporateActions.AddCommand}"/>
        </StackPanel>

        <!--
            Visibility must bind at THIS Grid's own (inherited) DataContext, not
            CorporateActionFormView's — a Binding and a DataContext override on the SAME element
            resolve the Binding against the new local DataContext, not the inherited one, so
            Visibility would silently fail to resolve and the form would never collapse.
            See docs/ui/wpf.md.
        -->
        <Grid Grid.Row="1"
              Visibility="{Binding AssetDetails.CorporateActions.IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:CorporateActionFormView DataContext="{Binding AssetDetails.CorporateActions.FormViewModel}"/>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="No corporate actions yet — nothing has changed this holding through a split, merger, or spin-off."
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,24,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding AssetDetails.CorporateActions.HasNoCorporateActions, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <DataGrid x:Name="HistoryGrid" Grid.Row="2"
                  ItemsSource="{Binding AssetDetails.CorporateActions.CorporateActions}"
                  SelectedItem="{Binding AssetDetails.CorporateActions.SelectedCorporateAction, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Visibility="{Binding AssetDetails.CorporateActions.HasVisibleCorporateActions, Converter={StaticResource BoolToVisibilityConverter}}"
                  behaviors:SortableColumnsBehavior.DefaultSortMemberPath="EffectiveDate"
                  behaviors:SortableColumnsBehavior.DefaultSortDirection="Descending">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding AssetDetails.CorporateActions.UpdateCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"
                                    Binding="{Binding EffectiveDate, Converter={StaticResource DateFormatConverter}, ConverterParameter='d'}"
                                    Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding TypeLabel}"
                                    Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Affected/Linked Asset"
                                    Binding="{Binding AffectedAssetName}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Resulting Change"
                                    Binding="{Binding ResultingChange}"
                                    Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlainColumnTextStyle}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Tax Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Background="{Binding StatusBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding HasCalculationStatus, Converter={StaticResource BoolToVisibilityConverter}}"
                                        AutomationProperties.Name="{Binding StatusAccessibleLabel}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding StatusSymbol}"
                                                       Filled="{Binding StatusSymbolFilled}"
                                                       Foreground="{Binding StatusForeground}"/>
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="{Binding StatusForeground}"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="—"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding HasNoCalculationStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Transparent"
                                           Icon="{ui:SymbolIcon Symbol=Edit16}"
                                           Command="{Binding DataContext.AssetDetails.CorporateActions.UpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Edit" AutomationProperties.Name="Edit"
                                           Padding="2"
                                           Margin="0,0,4,0"/>
                                <ui:Button Appearance="Transparent"
                                           Icon="{ui:SymbolIcon Symbol=Delete16}"
                                           Command="{Binding DataContext.AssetDetails.CorporateActions.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Delete" AutomationProperties.Name="Delete"
                                           Padding="2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
