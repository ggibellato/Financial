<UserControl x:Class="Financial.Presentation.App.Views.Settings.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Appearance" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <TextBlock Text="Colour mode" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <RadioButton GroupName="ColourMode"
                     Content="Light"
                     IsChecked="{Binding IsLightSelected}"
                     Margin="0,0,0,4"/>
        <RadioButton GroupName="ColourMode"
                     Content="Dark"
                     IsChecked="{Binding IsDarkSelected}"/>
    </StackPanel>
</UserControl>
