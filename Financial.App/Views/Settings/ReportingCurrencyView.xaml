<UserControl x:Class="Financial.Presentation.App.Views.Settings.ReportingCurrencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Reporting Currency" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <TextBlock Text="Currency" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <RadioButton GroupName="ReportingCurrency"
                     Content="GBP"
                     IsChecked="{Binding IsGbpSelected}"
                     Margin="0,0,0,4"/>
        <RadioButton GroupName="ReportingCurrency"
                     Content="BRL"
                     IsChecked="{Binding IsBrlSelected}"
                     Margin="0,0,0,4"/>
        <RadioButton GroupName="ReportingCurrency"
                     Content="USD"
                     IsChecked="{Binding IsUsdSelected}"/>

        <TextBlock Text="{Binding SaveError}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="{Binding SaveError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
    </StackPanel>
</UserControl>
