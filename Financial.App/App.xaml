<Application x:Class="Financial.Presentation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Financial.Presentation.App"
             xmlns:converters="clr-namespace:Financial.Presentation.App.Converters"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels"
             xmlns:controls="clr-namespace:Financial.Presentation.App.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ui:ThemesDictionary Theme="Light"/>
            <ui:ControlsDictionary/>
        </ResourceDictionary.MergedDictionaries>
        <converters:PositionTypeToColorConverter x:Key="PositionTypeToColorConverter"/>
        <converters:DateFormatConverter x:Key="DateFormatConverter"/>
        <converters:TransactionTypeToColorConverter x:Key="TransactionTypeToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:SortDirectionToArrowConverter x:Key="SortDirectionToArrowConverter"/>
        <converters:NodeTypeToVisibilityConverter x:Key="NodeTypeToVisibilityConverter"/>
        <converters:SignedValueToBrushConverter x:Key="SignedValueToBrushConverter"/>
        <converters:BetweenTextSeparatorConverter x:Key="BetweenTextSeparatorConverter"/>
        <converters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter"/>
        <converters:DoubleToDataGridLengthConverter x:Key="DoubleToDataGridLengthConverter"/>
        <converters:BoolToSidebarWidthConverter x:Key="BoolToSidebarWidthConverter"/>
        <converters:CategoryHasSelectedChildConverter x:Key="CategoryHasSelectedChildConverter"/>
        <converters:GroupHasSelectedChildConverter x:Key="GroupHasSelectedChildConverter"/>
        <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter"/>
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTimeConverter"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
        <converters:BillStatusToBrushConverter x:Key="BillStatusToBrushConverter"/>

        <!-- Assigning a DataGridColumn.Header to a ColumnFilterViewModelBase instance (in a
             view's code-behind, since DataGridColumn isn't part of the visual tree and can't
             itself host an ambient-DataContext binding) renders it through this template. -->
        <DataTemplate DataType="{x:Type vm:ColumnFilterViewModelBase}">
            <controls:FilterableColumnHeader/>
        </DataTemplate>

        <DrawingImage x:Key="AppIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1D6FB7">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0F4E87" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="2,6,20,14" RadiusX="2" RadiusY="2" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2A82C6">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="2,4,20,4" RadiusX="2" RadiusY="2" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F2C94C">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#C9971E" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="18,13" RadiusX="3" RadiusY="3" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0C2F4F" Thickness="2" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M6,18 L9,14 L12,16 L16,11" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        
        <Style TargetType="DataGrid">
            <!--
                Without this, DataGrid.Background is never set by this Style, so it falls
                through to the Aero2 theme's own default (SystemColors.ControlBrushKey - an OS
                control-face colour, not this app's theme). DataGridRow/DataGridColumnHeader's own
                Background overrides below are Wpf.Ui "fill" tokens - deliberately translucent,
                meant to be layered over an opaque surface, not to stand alone - so they only read
                correctly with an explicit, correct, opaque base underneath them.
            -->
            <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="behaviors:SortableColumnsBehavior.IsEnabled" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!--
                DataGridColumnHeader's built-in sort glyph is easy to miss against this theme,
                and the FilterableColumnHeader UserControl used on filterable columns overrides
                the header's Content entirely, bypassing it. Rendering an explicit arrow here -
                driven by the header's own SortDirection, outside whatever Content is hosted -
                keeps the indicator working for every column uniformly (see P37-F04 follow-up).

                The inner ContentPresenter MUST pin Content/ContentTemplate explicitly: a bare
                <ContentPresenter/> inside a ContentControl's own ContentTemplate re-inherits both
                Content and ContentTemplate from the nearest ContentControl ancestor (this header),
                which - left unset - reapplies this very template to itself forever
                (StackOverflowException in WindowsBase.dll).
            -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{x:Null}" VerticalAlignment="Center"/>
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10"
                                       Text="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Converter={StaticResource SortDirectionToArrowConverter}}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedBackgroundThemeBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="primitives:Selector.IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedBackgroundThemeBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource SystemAccentColorPrimary}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextOnAccentFillColorPrimary}"/>
            </Style.Resources>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedBackgroundThemeBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="primitives:Selector.IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedBackgroundThemeBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Per-field validation error text (P38-F02) — additive to a form's existing
             bottom-of-form error message, shown directly under the field it describes.
             SystemFillColorCriticalBrush resolves via the app-wide theme dictionary
             ApplicationThemeManager applies at startup (see P43-F02) — no per-view merge needed. -->
        <Style x:Key="FieldErrorTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
            <Setter Property="Visibility">
                <Setter.Value>
                    <Binding RelativeSource="{RelativeSource Self}" Path="Text"
                             Converter="{StaticResource NullOrEmptyToVisibilityConverter}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared "chip" toggle text for chart filter/mode bars (Transactions/Credits/
             PriceHistory) — flat, underlined when unselected, bold/no-underline when
             selected. Matches Web's TabList-driven equivalent (docs/ui/forms-data-and-
             visualisations.md's "Filter/chart-mode toggle" convention); the underlying
             control here stays a Button+Command (not a RadioButton) since the ViewModels
             already drive selection that way and re-plumbing IsChecked bindings isn't
             needed to fix the actual gap (hardcoded, non-theme-aware colours). -->
        <Style x:Key="FilterToggleLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="FilterToggleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="TextDecorations" Value="{x:Null}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumericColumnTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- WPF's implicit-style lookup does not apply to the TextBlock a DataGridTextColumn
             generates internally, so every plain (non-numeric) text column must reference
             this explicitly via ElementStyle to get the same vertical centering. -->
        <Style x:Key="PlainColumnTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Group-header overlay bar shown above a DataGrid's own column headers,
             used to visually merge related columns under one spanning title. -->
        <Style x:Key="GroupHeaderBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="GroupHeaderTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>



