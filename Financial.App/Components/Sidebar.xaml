<UserControl x:Class="Financial.Presentation.App.Components.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nav="clr-namespace:Financial.Presentation.App.Navigation"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="240">
    <UserControl.Resources>
        <DataTemplate x:Key="NavChildButtonTemplate" DataType="{x:Type nav:NavChild}">
            <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding ViewKey}"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,4"
                    Margin="0,1">
                <Button.Tag>
                    <MultiBinding Converter="{StaticResource EqualityToBoolConverter}">
                        <Binding Path="ViewKey"/>
                        <Binding Path="DataContext.SelectedChildId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Button.Tag>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Label}"/>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="NavGroupExpanderTemplate" DataType="{x:Type nav:NavGroup}">
            <Expander Margin="0,0,0,2">
                <Expander.Header>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource GroupHasSelectedChildConverter}">
                                                <Binding Path="Children"/>
                                                <Binding Path="DataContext.SelectedChildId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource NavChildButtonTemplate}" Margin="16,4,0,0"/>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Top"
                    Command="{Binding ToggleCollapsedCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    Margin="4"
                    Padding="8">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="ToolTip" Value="Collapse sidebar"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="ToolTip" Value="Expand sidebar"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Data="M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 Z M9,3 L9,21"
                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Width="20"
                      Height="20"
                      Stretch="Uniform"/>
            </Button>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type nav:NavCategory}">
                            <StackPanel>
                                <Separator Margin="8,6,8,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}">
                                    <Separator.Style>
                                        <Style TargetType="Separator">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Id}" Value="admin">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Separator.Style>
                                </Separator>
                                <StackPanel x:Name="CategoryHeaderPanel"
                                            Orientation="Horizontal"
                                            Margin="8,10,8,4"
                                            Focusable="{Binding DataContext.IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            MouseEnter="CategoryHeader_MouseEnter"
                                            MouseLeave="CategoryHeader_MouseLeave"
                                            GotKeyboardFocus="CategoryHeader_GotKeyboardFocus"
                                            LostKeyboardFocus="CategoryHeader_LostKeyboardFocus"
                                            PreviewKeyDown="CategoryHeader_PreviewKeyDown">
                                    <StackPanel.Tag>
                                        <MultiBinding Converter="{StaticResource CategoryHasSelectedChildConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.SelectedChildId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </StackPanel.Tag>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{Binding IconData}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="20"
                                          Height="20"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource NavChildButtonTemplate}" Margin="28,0,8,8">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource NavGroupExpanderTemplate}" Margin="20,0,8,8">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>

                                <Popup x:Name="CategoryFlyoutPopup"
                                       PlacementTarget="{Binding ElementName=CategoryHeaderPanel}"
                                       Placement="Right"
                                       StaysOpen="True"
                                       AllowsTransparency="True"
                                       PopupAnimation="None">
                                    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="0,8"
                                            MinWidth="180"
                                            MouseEnter="FlyoutPopup_MouseEnter"
                                            MouseLeave="FlyoutPopup_MouseLeave"
                                            PreviewKeyDown="FlyoutPopup_PreviewKeyDown">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="12,4,12,8"/>
                                            <ItemsControl ItemsSource="{Binding Children}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type nav:NavChild}">
                                                        <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding ViewKey}"
                                                                Click="FlyoutChild_Click"
                                                                HorizontalContentAlignment="Left"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="12,6"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Groups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type nav:NavGroup}">
                                                        <StackPanel Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       FontSize="11" Margin="12,4,12,4"/>
                                                            <ItemsControl ItemsSource="{Binding Children}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type nav:NavChild}">
                                                                        <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding ViewKey}"
                                                                                Click="FlyoutChild_Click"
                                                                                HorizontalContentAlignment="Left"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Padding="12,6"
                                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                                            <TextBlock Text="{Binding Label}"/>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
