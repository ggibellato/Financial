<UserControl x:Class="Financial.Presentation.App.Components.MonthYearPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="monthComboBox" Width="120" SelectionChanged="OnMonthSelectionChanged"/>
        <ComboBox x:Name="yearComboBox" Width="80" Margin="8,0,0,0" SelectionChanged="OnYearSelectionChanged"/>
    </StackPanel>
</UserControl>
