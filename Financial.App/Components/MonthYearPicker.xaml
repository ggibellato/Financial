<UserControl x:Class="Financial.Presentation.App.Components.MonthYearPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Month and year read as ONE control, not two independent dropdowns —
        mirrors Financial.Web's native <input type="month"> (see
        docs/ui/forms-data-and-visualisations.md's "Month/year selection" rule).
        Still two ComboBoxes internally (see code-behind), just visually unified:
        one border/background around both, a thin divider instead of a gap.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="1" CornerRadius="4" Padding="2"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}">
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="monthComboBox" Width="130" BorderThickness="0" Background="Transparent"
                      AutomationProperties.Name="Month" SelectionChanged="OnMonthSelectionChanged"/>
            <Border Width="1" Margin="2,4" Background="{DynamicResource ControlElevationBorderBrush}"/>
            <ComboBox x:Name="yearComboBox" Width="90" BorderThickness="0" Background="Transparent"
                      AutomationProperties.Name="Year" SelectionChanged="OnYearSelectionChanged"/>
        </StackPanel>
    </Border>
</UserControl>
