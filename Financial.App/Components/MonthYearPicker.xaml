<UserControl x:Class="Financial.Presentation.App.Components.MonthYearPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        A single flat, bordered field showing "MMMM yyyy" that opens a
        fixed-size popup with a year header (prev/next arrows) and a 4x3 grid
        of month cells — no day is ever selectable, mirroring Financial.Web's
        native <input type="month"> (see docs/ui/forms-data-and-visualisations
        .md's "Month/year selection" rule). Month cells match the browser's
        own month-picker popup exactly (see the reference screenshot in that
        doc section): flat text at rest, a solid rounded accent highlight only
        on the selected month — not a "board" of bordered buttons. That's why
        cells use a custom flat ControlTemplate instead of ui:Button/
        WPF-UI's Calendar Year view: a bare Calendar's Year view has no
        bounded natural size inside an unconstrained Popup (rendered full
        screen-width before a month was ever picked), and ui:Button's default
        chrome/border reads as a grid of buttons rather than flat text.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="FlatMonthButtonStyle" TargetType="Button">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="0,6"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                            Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SelectedMonthButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatMonthButtonStyle}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#0F6CBD"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!--
            Flat trigger — Financial.Web's <input type="month"> is a plain
            bordered field, not a raised/filled button, so the outline comes
            from this Border and the ui:Button inside stays Appearance=
            Transparent (no fill/shadow of its own).
        -->
        <Border BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ui:Button x:Name="triggerButton" MinWidth="140" HorizontalContentAlignment="Left"
                       Appearance="Transparent"
                       Icon="{ui:SymbolIcon Symbol=CalendarMonth20}"
                       Click="OnTriggerButtonClick"/>
        </Border>
        <Popup x:Name="popup" PlacementTarget="{Binding ElementName=triggerButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Width="220" BorderThickness="1" CornerRadius="4" Padding="8"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource FlatMonthButtonStyle}" Padding="6,4"
                                Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                AutomationProperties.Name="Previous year"
                                Click="OnPreviousYearClick"/>
                        <TextBlock x:Name="yearHeaderText" Grid.Column="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                        <Button Grid.Column="2" Style="{StaticResource FlatMonthButtonStyle}" Padding="6,4"
                                Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                AutomationProperties.Name="Next year"
                                Click="OnNextYearClick"/>
                    </Grid>
                    <UniformGrid x:Name="monthsGrid" Columns="4" Rows="3"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
