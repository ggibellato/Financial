<UserControl x:Class="Financial.Presentation.App.Components.NavigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.Investment"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors"
             xmlns:views="clr-namespace:Financial.Presentation.App.Views.Investment"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="400"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Navigation Tree -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10,10,10,0">
                <TextBlock Text="Investments"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#333333"/>
                <TextBlock Text="Asset class"
                           Margin="0,6,0,2"
                           FontSize="12"
                           Foreground="#666666"/>
                <ComboBox ItemsSource="{Binding AssetClassFilters}"
                          SelectedItem="{Binding SelectedAssetClassFilter}"
                          DisplayMemberPath="Label"
                          MinWidth="180"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Move Asset..."
                            Command="{Binding MoveAssetCommand}"
                            Padding="10,3"/>
                    <Button Content="Delete Portfolio"
                            Command="{Binding DeletePortfolioCommand}"
                            Padding="10,3"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <TreeView Grid.Row="1" 
                      ItemsSource="{Binding RootNodes}"
                      Margin="10,0,10,10"
                      behaviors:TreeViewDragDropBehavior.IsEnabled="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <!-- Keep selection color when control loses focus -->
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Bound to the node, not the container: the tree recycles its
                                 containers, so a recycled one would carry a stale highlight. -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="Background" Value="#CCE8FF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Style.Resources>
                            <!-- Override inactive selection color to match active selection -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#007ACC"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                        </Style.Resources>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Icon for Asset nodes colored by position type -->
                            <TextBlock Text="●"
                                       Foreground="{Binding PositionType, Converter={StaticResource PositionTypeToColorConverter}}"
                                       Visibility="{Binding NodeType, Converter={StaticResource NodeTypeToVisibilityConverter}}"
                                       Margin="0,0,5,0"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding DisplayName}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Loading Indicator -->
            <Grid Grid.Row="1" 
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="#80FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                    <TextBlock Text="Loading..." 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,0"
                               FontSize="14"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" 
                      Width="5" 
                      HorizontalAlignment="Stretch" 
                      Background="#E0E0E0"/>

        <!-- Right Panel: Asset Details -->
        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Asset Header -->
            <Border Grid.Row="0" 
                    BorderBrush="#CCCCCC" 
                    BorderThickness="0,0,0,1" 
                    Padding="0,0,0,10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AssetDetails.AssetName, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>
                        <Button Command="{Binding AssetDetails.CopyAssetNameCommand}"
                                ToolTip="Copy asset name"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2"
                                Margin="4,0,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" Foreground="#666666"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0">
                        <Run Text="{Binding AssetDetails.Ticker, Mode=OneWay}"/>
                        <Run>
                            <Run.Text>
                                <MultiBinding Converter="{StaticResource BetweenTextSeparatorConverter}" ConverterParameter=" · " Mode="OneWay">
                                    <Binding Path="AssetDetails.Ticker" Mode="OneWay"/>
                                    <Binding Path="AssetDetails.Exchange" Mode="OneWay"/>
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                        <Run Text="{Binding AssetDetails.Exchange, Mode=OneWay}"/>
                        <Run>
                            <Run.Text>
                                <MultiBinding Converter="{StaticResource BetweenTextSeparatorConverter}" ConverterParameter=" · " Mode="OneWay">
                                    <Binding Path="AssetDetails.Exchange" Mode="OneWay"/>
                                    <Binding Path="AssetDetails.BrokerName" Mode="OneWay"/>
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                        <Run Text="{Binding AssetDetails.BrokerName, Mode=OneWay}"/>
                        <Run>
                            <Run.Text>
                                <MultiBinding Converter="{StaticResource BetweenTextSeparatorConverter}" ConverterParameter=" · " Mode="OneWay">
                                    <Binding Path="AssetDetails.BrokerName" Mode="OneWay"/>
                                    <Binding Path="AssetDetails.PortfolioName" Mode="OneWay"/>
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                        <Run Text="{Binding AssetDetails.PortfolioName, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Tab Control for Details -->
            <TabControl Grid.Row="1">
                <TabItem Header="Summary">
                    <views:PortfolioSummaryView/>
                </TabItem>
                <TabItem Header="Transactions">
                    <views:TransactionsView/>
                </TabItem>
                <TabItem Header="Credits">
                    <views:CreditsView/>
                </TabItem>
                <TabItem Header="Price History">
                    <views:PriceHistoryView/>
                </TabItem>
            </TabControl>

            <!-- Empty State -->
            <StackPanel Grid.Row="1" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Visibility="{Binding AssetDetails.ShouldShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Select an asset to view details" 
                           FontSize="16" 
                           Foreground="#999999"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>












