<UserControl x:Class="Financial.Presentation.App.Components.NavigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:Financial.Presentation.App.ViewModels.Investment"
             xmlns:behaviors="clr-namespace:Financial.Presentation.App.Behaviors"
             xmlns:views="clr-namespace:Financial.Presentation.App.Views.Investment"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Matches Financial.Web's accent exactly — see the same override in ExpenseFormView.xaml. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#115EA3"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0C3B5E"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="400"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10,10,10,0">
                <TextBlock Text="Investments"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Asset class"
                           Margin="0,6,0,2"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding AssetClassFilters}"
                          SelectedItem="{Binding SelectedAssetClassFilter}"
                          DisplayMemberPath="Label"
                          MinWidth="180"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="Move Asset..." Appearance="Primary" Icon="{ui:SymbolIcon Symbol=ArrowMove20}"
                               Command="{Binding MoveAssetCommand}"/>
                    <ui:Button Content="Delete Portfolio" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Delete20}"
                               Command="{Binding DeletePortfolioCommand}"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <TreeView Grid.Row="1" 
                      ItemsSource="{Binding RootNodes}"
                      Margin="10,0,10,10"
                      behaviors:TreeViewDragDropBehavior.IsEnabled="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedBackgroundThemeBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}"/>
                            </Trigger>
                            <!-- Bound to the node, not the container: the tree recycles its
                                 containers, so a recycled one would carry a stale highlight. -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Style.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource SystemAccentColorPrimary}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextOnAccentFillColorPrimary}"/>
                        </Style.Resources>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●"
                                       Foreground="{Binding PositionType, Converter={StaticResource PositionTypeToColorConverter}}"
                                       Visibility="{Binding NodeType, Converter={StaticResource NodeTypeToVisibilityConverter}}"
                                       Margin="0,0,5,0"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding DisplayName}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <Grid Grid.Row="1" 
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="#66000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                    <TextBlock Text="Loading..." 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,0"
                               FontSize="14"/>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AssetDetails.AssetName, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:Button Command="{Binding AssetDetails.CopyAssetNameCommand}"
                                   ToolTip="Copy asset name"
                                   Appearance="Transparent"
                                   Icon="{ui:SymbolIcon Symbol=Copy20}"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0">
                        <Run Text="{Binding AssetDetails.Ticker, Mode=OneWay}"/>
                        <Run>
                            <Run.Text>
                                <MultiBinding Converter="{StaticResource BetweenTextSeparatorConverter}" ConverterParameter=" · " Mode="OneWay">
                                    <Binding Path="AssetDetails.Ticker" Mode="OneWay"/>
                                    <Binding Path="AssetDetails.Exchange" Mode="OneWay"/>
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                        <Run Text="{Binding AssetDetails.Exchange, Mode=OneWay}"/>
                        <Run>
                            <Run.Text>
                                <MultiBinding Converter="{StaticResource BetweenTextSeparatorConverter}" ConverterParameter=" · " Mode="OneWay">
                                    <Binding Path="AssetDetails.Exchange" Mode="OneWay"/>
                                    <Binding Path="AssetDetails.BrokerName" Mode="OneWay"/>
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                        <Run Text="{Binding AssetDetails.BrokerName, Mode=OneWay}"/>
                        <Run>
                            <Run.Text>
                                <MultiBinding Converter="{StaticResource BetweenTextSeparatorConverter}" ConverterParameter=" · " Mode="OneWay">
                                    <Binding Path="AssetDetails.BrokerName" Mode="OneWay"/>
                                    <Binding Path="AssetDetails.PortfolioName" Mode="OneWay"/>
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                        <Run Text="{Binding AssetDetails.PortfolioName, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding AssetDetails.SelectedDetailTabIndex, Mode=OneWay}">
                <TabItem Header="Summary">
                    <views:PortfolioSummaryView/>
                </TabItem>
                <TabItem Header="Transactions">
                    <views:TransactionsView/>
                </TabItem>
                <TabItem Header="Credits">
                    <views:CreditsView/>
                </TabItem>
                <TabItem Header="Price History"
                         Visibility="{Binding AssetDetails.IsAssetView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:PriceHistoryView/>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="1" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Visibility="{Binding AssetDetails.ShouldShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Select an asset to view details"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>












