<UserControl x:Class="Financial.Presentation.App.Components.PaymentDueBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="600">
    <Border Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="Upcoming payments" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <ui:Button Appearance="Transparent"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Command="{Binding DismissCommand}"
                           AutomationProperties.Name="Dismiss upcoming payments">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss20"/>
                    </ui:Button.Icon>
                </ui:Button>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Payments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="{Binding UrgencyBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    AutomationProperties.Name="{Binding UrgencyAccessibleLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding UrgencySymbol}"
                                                   Filled="{Binding UrgencySymbolFilled}"
                                                   Foreground="{Binding UrgencyForeground}"/>
                                    <TextBlock Text="{Binding DaysRemainingText}"
                                               Foreground="{Binding UrgencyForeground}"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding TypeLabel}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DateFormatConverter}}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
