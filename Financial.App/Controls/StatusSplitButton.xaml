<UserControl x:Class="Financial.Presentation.App.Controls.StatusSplitButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="root">
    <!--
        Matches the React StatusMenuButton: the whole button (not just the chevron) opens the
        Flyout - Click bubbles from any part of ui:SplitButton, including its internal chevron
        ToggleButton, so forcing IsDropDownOpen true (never toggling) is idempotent with whatever
        the chevron's own internal handling already does, avoiding a double-toggle no-op.
    -->
    <ui:SplitButton x:Name="Split"
                    Click="OnSplitButtonClick"
                    AutomationProperties.Name="{Binding Status, ElementName=root, StringFormat='Status: {0}. Change status'}">
        <!--
            Status color lives on this inner badge only (matching React's Badge-inside-a-neutral-
            MenuButton), not on the SplitButton's own Background/Foreground - those get overridden
            by the library's MouseOver/Pressed chrome, which made "Paid" unreadable on hover.
        -->
        <Border Background="{Binding Status, ElementName=root, Converter={StaticResource BillStatusToBrushConverter}, ConverterParameter=Background}"
                CornerRadius="4" Padding="8,2">
            <TextBlock Text="{Binding Status, ElementName=root}"
                       Foreground="{Binding Status, ElementName=root, Converter={StaticResource BillStatusToBrushConverter}, ConverterParameter=Foreground}"/>
        </Border>
        <ui:SplitButton.Flyout>
            <!--
                Flyout content is a Popup root and does not inherit the outer visual tree's
                DataContext (see docs/ui/wpf.md), so every binding below reaches back to this
                control's own dependency properties via ElementName=root rather than {Binding}.
            -->
            <ui:Flyout Placement="Bottom">
                <ItemsControl ItemsSource="{Binding Statuses, ElementName=root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Appearance="Transparent" Padding="8,6" Click="OnStatusItemClick">
                                <ui:Button.Tag>
                                    <MultiBinding Converter="{StaticResource EqualityToBoolConverter}">
                                        <Binding/>
                                        <Binding Path="Status" ElementName="root"/>
                                    </MultiBinding>
                                </ui:Button.Tag>
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark20" Margin="0,0,6,0"
                                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}, Path=Tag, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Flyout>
        </ui:SplitButton.Flyout>
    </ui:SplitButton>
</UserControl>
