<UserControl x:Class="Financial.Presentation.App.Controls.StatusSplitButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="root">
    <!--
        Only the chevron opens the menu, matching Wpf.Ui.Controls.SplitButton's native two-zone
        convention - its own internal chevron-click wiring (OnSplitButtonToggleButtonOnClick)
        only does anything when Flyout is a real System.Windows.Controls.ContextMenu (confirmed
        against the library source; a ui:Flyout here silently no-ops on every click, and
        IsDropDownOpen is a one-way readback of the ContextMenu's Opened/Closed state, not
        something that opens anything when set). An earlier attempt to also open on a plain-badge
        click, by handling this SplitButton's own bubbled Click, caused the chevron's open/close to
        flicker and interfered with selecting an item - removed; the library's own mechanism is the
        one to rely on here.
    -->
    <ui:Button x:Name="Split"
               Click="OnSplitButtonClick"
               AutomationProperties.Name="{Binding Status, ElementName=root, StringFormat='Status: {0}. Change status'}">
        <!--
            Status color lives on this inner badge only (matching React's Badge-inside-a-neutral-
            MenuButton), not on the SplitButton's own Background/Foreground - those get overridden
            by the library's MouseOver/Pressed chrome, which made "Paid" unreadable on hover.
        -->
        <Border Background="{Binding Status, ElementName=root, Converter={StaticResource BillStatusToBrushConverter}, ConverterParameter=Background}"
                CornerRadius="4" Padding="8,2">
            <TextBlock Text="{Binding Status, ElementName=root}"
                       Foreground="{Binding Status, ElementName=root, Converter={StaticResource BillStatusToBrushConverter}, ConverterParameter=Foreground}"/>
        </Border>
        <ui:Button.ContextMenu>
            <!--
                A ContextMenu is not part of the visual tree it's declared in - it gets its own
                NameScope and does not inherit ambient DataContext, so {Binding ElementName=root}
                would silently resolve to nothing here (confirmed: it left ItemsSource null,
                rendering an empty menu). StatusSplitButton's constructor sets this ContextMenu's
                DataContext to itself; every binding below reaches back to it via
                RelativeSource AncestorType=ContextMenu rather than ElementName.
            -->
            <ContextMenu ItemsSource="{Binding Statuses}">
                <ContextMenu.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <EventSetter Event="Click" Handler="OnStatusItemClick"/>
                        <Setter Property="Header" Value="{Binding}"/>
                        <Setter Property="Tag">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource EqualityToBoolConverter}">
                                    <Binding/>
                                    <Binding Path="DataContext.Status" RelativeSource="{RelativeSource AncestorType={x:Type ContextMenu}}"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Icon">
                                    <Setter.Value>
                                        <ui:SymbolIcon Symbol="Checkmark20"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContextMenu.ItemContainerStyle>
            </ContextMenu>
        </ui:Button.ContextMenu>
    </ui:Button>
</UserControl>
