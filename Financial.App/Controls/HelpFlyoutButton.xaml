<UserControl x:Class="Financial.Presentation.App.Controls.HelpFlyoutButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <ui:Button x:Name="InfoButton" Appearance="Transparent" Padding="2"
                   Icon="{ui:SymbolIcon Symbol=Info16}"
                   AutomationProperties.Name="{Binding HelpText, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Help: {0}'}"
                   Click="OnInfoButtonClick"/>
        <ui:Flyout x:Name="HelpFlyout" Placement="Bottom">
            <TextBlock Text="{Binding HelpText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       MaxWidth="260" TextWrapping="Wrap"/>
        </ui:Flyout>
    </StackPanel>
</UserControl>
