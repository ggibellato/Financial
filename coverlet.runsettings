<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Excludes compiler/source-generator output (e.g. Microsoft.AspNetCore.OpenApi's
               XmlCommentGenerator) from coverage - it isn't code we write or can test. -->
          <ExcludeByFile>**/obj/**/*.cs</ExcludeByFile>
          <!-- Excludes test-support and one-off tooling/vendor-wrapper assemblies from the
               coverage gate: TestUtilities is test fixtures, not application code; the two
               spreadsheet-import tools are rarely-run migration utilities; GoogleSheets is a
               thin vendor SDK wrapper (see docs' "Integration SDK isolation" convention).
               None of these represent app logic the coverage % is meant to signal on.

               Also excludes Financial.Presentation.App's XAML/bootstrap boundary: Views,
               Components and Controls are code-behind tested via contract (binding) tests +
               manual verification, never unit tests (testing-guide-Financial skill,
               artifacts/wpf-views-and-xaml.md); App/MainWindow/Properties.Settings are
               composition-root and generated-settings code. The six named classes are thin
               visual-tree/dialog glue the same skill's artifacts/wpf-converters-behaviors-helpers.md
               and artifacts/wpf-viewmodels.md already document as untestable-by-design - their
               real logic is covered elsewhere (e.g. TreeViewDragDropBehavior's drop decision via
               MainNavigationViewModelMoveTests; DialogService's real logic is why IDialogService /
               StubDialogService exist). None of this is code the 90% WPF coverage gate can
               meaningfully signal on. -->
          <Exclude>[Financial.TestUtilities]*,[Financial.CashFlow.Infrastructure.Tools.CashFlowSpreadsheetImport]*,[Financial.Investment.SpreadsheetImport]*,[Financial.Integrations.GoogleSheets]*,[Financial.Presentation.App]Financial.Presentation.App.Views.*,[Financial.Presentation.App]Financial.Presentation.App.Components.*,[Financial.Presentation.App]Financial.Presentation.App.Controls.*,[Financial.Presentation.App]Financial.Presentation.App.App,[Financial.Presentation.App]Financial.Presentation.App.MainWindow,[Financial.Presentation.App]Financial.Presentation.App.Properties.Settings,[Financial.Presentation.App]Financial.Presentation.App.Behaviors.TreeViewDragDropBehavior,[Financial.Presentation.App]Financial.Presentation.App.Behaviors.SortableColumnsBehavior,[Financial.Presentation.App]Financial.Presentation.App.Behaviors.DecimalInputBehavior,[Financial.Presentation.App]Financial.Presentation.App.Helpers.BindingProxy,[Financial.Presentation.App]Financial.Presentation.App.ViewModels.AdminEntityPlaceholderViewModel,[Financial.Presentation.App]Financial.Presentation.App.Services.DialogService</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
