<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Financial.Investment.TransactionIncomeVocabularyMigration</RootNamespace>
    <AssemblyName>Financial.Investment.TransactionIncomeVocabularyMigration</AssemblyName>
