<Window x:Class="Financial.Investment.Infrastructure.Tools.ImportGoogleSpreadSheets.ImportIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Import Issues" Height="450" Width="700"
        WindowStartupLocation="CenterOwner" Icon="{StaticResource AppIcon}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding IssueCountText}" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" Text="{Binding IssuesText, Mode=OneWay}"
                  IsReadOnly="True" IsReadOnlyCaretVisible="True"
                  TextWrapping="Wrap" AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                  FontFamily="Consolas" Padding="5"/>

        <Button Grid.Row="2" Content="Close" Width="80" Height="28" Margin="0,10,0,0"
                HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
